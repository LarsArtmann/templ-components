package errorpage

import "github.com/larsartmann/templ-components/utils"

templ ErrorPage(props ErrorPageProps) {
	{{ style := lookupFamilyStyle(props.Family) }}
	<main
		if props.ID != "" {
			id={ props.ID }
		}
		class={ utils.Class("min-h-screen flex items-center justify-center p-4 bg-gray-50 dark:bg-gray-900", props.Class) }
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		{ props.Attrs... }
	>
		<div class="w-full max-w-xl">
			<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:shadow-black/20">
				<div class={ "h-1", style.Bar } aria-hidden="true"></div>
				<div class="px-6 py-8 sm:px-10 sm:py-10">
					<div class="flex flex-wrap items-center gap-x-4 gap-y-3">
						<div class={ "flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full", style.AccentBG }>
							@familyIcon(style, "h-6 w-6")
						</div>
						@errorChips(props.StatusCode, props.Family, style, props.Code)
					</div>
					if props.Title != "" {
						<h1 class="mt-5 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">{ props.Title }</h1>
					}
					if props.Message != "" {
						<p class="mt-2.5 text-base leading-relaxed text-gray-600 dark:text-gray-300">{ props.Message }</p>
					}
					if props.Why != "" {
						<p class="mt-4 text-sm leading-relaxed text-gray-500 dark:text-gray-400">{ props.Why }</p>
					}
					@diagnosticSection(props.Fix, props.Context, props.CauseChain, "mt-6 space-y-3", "Cause chain", errorInsetNeutral)
					if props.WayOut != "" || props.WayOutHref != "" || props.SecondaryWayOut != "" {
						<div class="mt-8 flex flex-wrap items-center gap-3">
							if props.WayOutHref != "" {
								<a
									href={ templ.SafeURL(props.WayOutHref) }
									class={ "inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold shadow-sm " + utils.TransitionColors + " focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2", style.ActionButton }
								>
									@actionLinkBody(utils.Ternary(props.WayOut != "", props.WayOut, "Go back"))
								</a>
							} else if props.WayOut != "" {
								<button
									type="button"
									data-tc-go-back
									class={ "inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold shadow-sm " + utils.TransitionColors + " focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2", style.ActionButton }
								>
									{ props.WayOut }
								</button>
							}
							if props.SecondaryWayOut != "" {
								if props.SecondaryWayOutHref != "" {
									<a
										href={ templ.SafeURL(props.SecondaryWayOutHref) }
										class={ "inline-flex items-center gap-2 rounded-lg border px-5 py-2.5 text-sm font-semibold " + utils.TransitionColors + " focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2", style.ActionButtonGhost }
									>
										{ props.SecondaryWayOut }
									</a>
								} else {
									<button
										type="button"
										data-tc-go-back
										class={ "inline-flex items-center gap-2 rounded-lg border px-5 py-2.5 text-sm font-semibold " + utils.TransitionColors + " focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2", style.ActionButtonGhost }
									>
										{ props.SecondaryWayOut }
									</button>
								}
							}
						</div>
					}
				</div>
				if props.ShowTimestamp || props.Trace != "" {
					@metaFooter(props.Timestamp, props.Trace, "px-6 py-3.5 sm:px-10 bg-gray-50/60 dark:bg-gray-900/40")
				}
			</div>
		</div>
	</main>
	if (props.WayOut != "" && props.WayOutHref == "") || (props.SecondaryWayOut != "" && props.SecondaryWayOutHref == "") {
		@goBackScript(props.Nonce)
	}
}
