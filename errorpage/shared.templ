package errorpage

import (
	"fmt"

	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/utils"
)

templ familyIcon(style familyVisualStyle, iconClass string) {
	@icons.Icon(style.Icon, utils.Class(iconClass, style.IconColor))
}

// errorBody renders the badge + title + message block that lives inside the
// `flex-1 min-w-0` content column of an error header (ErrorDetail). The icon
// and outer flex wrapper stay at the call site because their layout (gap,
// icon container decoration) differs per visual density.
//
// Parameters:
//   - titleTag: heading element — "h1" for hero/full, "h3" for compact.
//   - titleClass: Tailwind classes for the heading (mt-N + text size).
//   - messageClass: Tailwind classes for the message paragraph.
templ errorBody(style familyVisualStyle, family Family, code Code, title, titleTag, titleClass, message, messageClass string) {
	@errorChips(0, family, style, code)
	if title != "" {
		switch titleTag {
			case "h1":
				<h1 class={ titleClass }>{ title }</h1>
			case "h3":
				<h3 class={ titleClass }>{ title }</h3>
		}
	}
	if message != "" {
		<p class={ messageClass }>{ message }</p>
	}
}

// errorHeader renders the complete icon + content header for the compact
// error display (ErrorDetail). ErrorPage uses its own stacked hero layout.
templ errorHeader(
	gap string,
	iconContainerClass string,
	style familyVisualStyle,
	family Family,
	code Code,
	title string,
	titleTag string,
	titleClass string,
	message string,
	messageClass string,
) {
	<div class={ "flex items-start", gap }>
		<div class={ iconContainerClass }>
			@familyIcon(style, "h-5 w-5")
		</div>
		<div class="flex-1 min-w-0">
			@errorBody(style, family, code, title, titleTag, titleClass, message, messageClass)
		</div>
	</div>
}

templ fixCard(fix string, insetClass string) {
	<div class={ utils.Class("rounded-lg border px-3.5 py-3", insetClass) }>
		<p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-500">
			<span class="inline-flex items-center gap-1.5">
				@icons.Icon(icons.Wrench, "h-3.5 w-3.5")
				Suggested fix
			</span>
		</p>
		<p class="mt-1.5 text-sm leading-relaxed text-gray-700 dark:text-gray-300">{ fix }</p>
	</div>
}

templ causeList(causes []CauseItem, label string) {
	if len(causes) > 0 {
		<div class="space-y-1">
			<p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-500">{ label }</p>
			for _, cause := range causes {
				<div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
					<span class="h-1.5 w-1.5 rounded-full bg-gray-300 dark:bg-gray-600 flex-shrink-0"></span>
					<span class="font-mono">{ cause.Message }</span>
					if cause.Code != "" {
						<span class="text-gray-500 dark:text-gray-500">({ cause.Code })</span>
					}
				</div>
			}
		</div>
	}
}

templ contextTable(pairs []ContextPair, insetClass string) {
	if len(pairs) > 0 {
		<div class={ utils.Class("overflow-hidden rounded-lg border", insetClass) }>
			<table class="min-w-full text-xs">
				<caption class="sr-only">Error context</caption>
				<tbody class="divide-y divide-gray-100 dark:divide-gray-700">
					for _, pair := range pairs {
						<tr>
							<th scope="row" class="px-3 py-1.5 font-medium text-gray-500 dark:text-gray-400 whitespace-nowrap w-1/4 text-start">{ pair.Key }</th>
							<td class="px-3 py-1.5 font-mono text-gray-700 dark:text-gray-300 break-all">{ pair.Value }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// metaFooter renders the footer strip with the timestamp and/or the error's
// correlation trace ID (support hand-off). Rendered only when at least one
// is set; each entry is guarded independently.
templ metaFooter(timestamp string, trace string, class string) {
	if timestamp != "" || trace != "" {
		<div class={ class, "flex flex-wrap items-center justify-between gap-2 border-t border-gray-100 dark:border-gray-800" }>
			if timestamp != "" {
				<p class="text-xs text-gray-500 dark:text-gray-500">{ timestamp }</p>
			}
			if trace != "" {
				<p class="font-mono text-xs text-gray-500 dark:text-gray-500">Trace: { trace }</p>
			}
		</div>
	}
}

// familyBadge renders the family name as a tinted chip. Zero-value and
// unknown families render nothing (graceful degradation, same policy as
// AvatarStatus) instead of an empty visible element.
templ familyBadge(family Family, style familyVisualStyle) {
	if FamilyIsValid(family) {
		<span class={ "inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium", style.AccentBG, style.AccentText }>
			{ string(family) }
		</span>
	}
}

// errorChips renders the metadata chip row: optional HTTP status code,
// optional error code, and the family badge. Every chip is guarded — a
// zero-value field renders nothing instead of an empty chip.
templ errorChips(statusCode int, family Family, style familyVisualStyle, code Code) {
	if statusCode > 0 || code != "" || FamilyIsValid(family) {
		<div class="flex flex-wrap items-center gap-2">
			if statusCode > 0 {
				<span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 font-mono text-xs font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300">
					{ fmt.Sprintf("HTTP %d", statusCode) }
				</span>
			}
			if code != "" {
				<code class={ "inline-flex items-center rounded px-1.5 py-0.5 text-xs font-mono font-medium", style.AccentBG, style.AccentText }>
					{ code }
				</code>
			}
			@familyBadge(family, style)
		</div>
	}
}

// diagnosticSection renders the fix/context/cause diagnostic blocks. The
// containerClass owns the vertical rhythm (space-y); insetClass picks the
// panel surface for the current card background (errorInsetNeutral on the
// white ErrorPage card, errorInsetCard on tinted ErrorDetail cards).
templ diagnosticSection(fix string, context []ContextPair, causes []CauseItem, containerClass string, causeLabel string, insetClass string) {
	if fix != "" || len(context) > 0 || len(causes) > 0 {
		<div class={ containerClass }>
			if fix != "" {
				@fixCard(fix, insetClass)
			}
			@contextTable(context, insetClass)
			@causeList(causes, causeLabel)
		</div>
	}
}

// goBackScript renders the singleton history.back() delegation script shared
// by ErrorPage (WayOut button) and NotFound404 (ShowGoBack button). Both
// components use [data-tc-go-back] as the click target.
//
// Stays in errorpage until a second package needs history.back() — then
// promote to utils, following the DismissButton precedent (utils/dismiss.templ
// was promoted only when both feedback and errorpage needed the same markup).
templ goBackScript(nonce string) {
	<script nonce={ nonce }>
		if (!window.tcGoBackAttached) {
			window.tcGoBackAttached = true;
			document.addEventListener('click', function(e) {
				if (e.target.closest('[data-tc-go-back]')) history.back();
			});
		}
	</script>
}

// actionLinkBody renders the shared <span>text</span> + ArrowRight icon body
// used inside action <a> elements by ErrorPage and NotFound404.
templ actionLinkBody(text string) {
	<span>{ text }</span>
	@icons.IconRTL(icons.ArrowRight, "h-4 w-4")
}
