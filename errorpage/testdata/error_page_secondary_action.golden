<main class="bg-gray-50 dark:bg-gray-900 flex items-center justify-center min-h-screen p-4"><div class="max-w-xl w-full"><div class="bg-white border border-gray-200 dark:bg-gray-800 dark:border-gray-700 dark:shadow-black/20 overflow-hidden rounded-2xl shadow-sm"><div class="bg-blue-500 dark:bg-blue-400 h-1" aria-hidden="true"></div><div class="px-6 py-8 sm:px-10 sm:py-10"><div class="flex flex-wrap gap-x-4 gap-y-3 items-center"><div class="bg-blue-100 dark:bg-blue-900/30 flex flex-shrink-0 h-12 items-center justify-center rounded-full w-12"><svg class="dark:text-blue-400 h-6 text-blue-500 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.0228 9.34841H21.0154V9.34663M2.98413 19.6444V14.6517M2.98413 14.6517L7.97677 14.6517M2.98413 14.6517L6.16502 17.8347C7.15555 18.8271 8.41261 19.58 9.86436 19.969C14.2654 21.1483 18.7892 18.5364 19.9685 14.1353M4.03073 9.86484C5.21 5.46374 9.73377 2.85194 14.1349 4.03121C15.5866 4.4202 16.8437 5.17312 17.8342 6.1655L21.0154 9.34663M21.0154 4.3558V9.34663"></path></svg></div><div class="flex flex-wrap gap-2 items-center"><span class="bg-gray-100 dark:bg-gray-700 dark:text-gray-300 font-medium font-mono inline-flex items-center px-2 py-0.5 rounded-md text-gray-600 text-xs">HTTP 503</span> <span class="bg-blue-100 dark:bg-blue-900/30 dark:text-blue-300 font-medium inline-flex items-center px-2 py-0.5 rounded-md text-blue-700 text-xs">transient</span></div></div><h1 class="dark:text-white font-bold mt-5 text-2xl text-gray-900 tracking-tight">Service temporarily unavailable</h1><p class="dark:text-gray-300 leading-relaxed mt-2.5 text-base text-gray-600">We&#39;re performing maintenance or experiencing high traffic.</p><div class="flex flex-wrap gap-3 items-center mt-8"><a href="/" class="bg-blue-600 dark:bg-blue-500 dark:focus-visible:ring-blue-400 dark:hover:bg-blue-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:ring-blue-500 font-semibold gap-2 hover:bg-blue-500 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-5 py-2.5 rounded-lg shadow-sm text-sm text-white transition-colors"><span>Retry</span><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-tc-dir-icon><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg></a> <a href="mailto:support@example.com" class="bg-white border border border-blue-300 dark:bg-transparent dark:border-blue-700 dark:focus-visible:ring-blue-400 dark:hover:bg-blue-900/30 dark:text-blue-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:ring-blue-500 font-semibold gap-2 hover:bg-blue-50 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-5 py-2.5 rounded-lg text-blue-700 text-sm transition-colors">Contact support</a></div></div></div></div></main>