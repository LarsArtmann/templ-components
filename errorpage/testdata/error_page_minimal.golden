<main class="bg-gray-50 dark:bg-gray-900 flex items-center justify-center min-h-screen p-4"><div class="max-w-xl w-full"><div class="bg-white border border-gray-200 dark:bg-gray-800 dark:border-gray-700 dark:shadow-black/20 overflow-hidden rounded-2xl shadow-sm"><div class="bg-gray-400 dark:bg-gray-500 h-1" aria-hidden="true"></div><div class="px-6 py-8 sm:px-10 sm:py-10"><div class="flex flex-wrap gap-x-4 gap-y-3 items-center"><div class="bg-gray-100 dark:bg-gray-800 flex flex-shrink-0 h-12 items-center justify-center rounded-full w-12"><svg class="dark:text-gray-500 h-6 text-gray-400 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"></path></svg></div><div class="flex flex-wrap gap-2 items-center"><code class="bg-gray-100 dark:bg-gray-800 dark:text-gray-300 font-medium font-mono inline-flex items-center px-1.5 py-0.5 rounded text-gray-700 text-xs">internal.error</code><span class="bg-gray-100 dark:bg-gray-800 dark:text-gray-300 font-medium inline-flex items-center px-2 py-0.5 rounded-md text-gray-700 text-xs">infrastructure</span></div></div><h1 class="dark:text-white font-bold mt-5 text-2xl text-gray-900 tracking-tight">Something went wrong</h1><p class="dark:text-gray-300 leading-relaxed mt-2.5 text-base text-gray-600">An unexpected error occurred. Our team has been notified.</p><div class="flex flex-wrap gap-3 items-center mt-8"><button type="button" data-tc-go-back class="bg-gray-600 dark:bg-gray-500 dark:focus-visible:ring-gray-400 dark:hover:bg-gray-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:ring-gray-500 font-semibold gap-2 hover:bg-gray-500 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-5 py-2.5 rounded-lg shadow-sm text-sm text-white transition-colors">Go back</button> </div></div></div></div></main><script nonce="">
		if (!window.tcGoBackAttached) {
			window.tcGoBackAttached = true;
			document.addEventListener('click', function(e) {
				if (e.target.closest('[data-tc-go-back]')) history.back();
			});
		}
	</script>