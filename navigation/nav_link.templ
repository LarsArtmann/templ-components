package navigation

import (
	"github.com/larsartmann/templ-components/utils"
	"github.com/larsartmann/templ-components/utils/wire"
)

// navLinkBaseClass is the shared class prefix for active and inactive nav links.
// py-1.5 keeps the link box ≥ 24 CSS px (WCAG 2.2 target size): pt-1 rendered
// a 20px target (M21/F097 audit).
const navLinkBaseClass = "inline-flex items-center border-b-2 px-2 py-1.5 text-sm font-medium " + utils.TransitionColors

func navLinkClasses(isActive bool) string {
	if isActive {
		return navLinkBaseClass + " border-blue-500 text-gray-900 dark:text-white"
	}
	return navLinkBaseClass + " border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 dark:text-gray-400 dark:hover:border-gray-600 dark:hover:text-gray-200"
}

func mobileNavLinkClass(isActive bool) string {
	base := "block border-s-4 py-2 ps-3 pe-4 text-base font-medium " + utils.TransitionColors
	if isActive {
		return base + " border-blue-500 bg-blue-50 text-blue-700 dark:bg-blue-900/20 dark:text-blue-300"
	}
	return base + " border-transparent text-gray-500 hover:border-gray-300 hover:bg-gray-50 hover:text-gray-700 dark:text-gray-400 dark:hover:border-gray-600 dark:hover:bg-gray-800 dark:hover:text-gray-200"
}

// IsActive returns true when href matches currentPath exactly. Shared by NavLink
// and SidebarNav so active-state detection stays consistent across the package.
func IsActive(href, currentPath string) bool {
	return href == currentPath
}

// NavLinkProps configures a single navigation link
type NavLinkProps struct {
	utils.BaseProps
	Href     string
	Text     string
	External bool
	// Wire, when set with a non-empty URL, adds transport wiring to the
	// link: the anchor keeps its href (the no-JS fallback) AND carries the
	// action's dialect attributes (htmx: hx-get + hx-target; Datastar:
	// data-on:click). Use it for nav links that patch a page region instead
	// of navigating; the wire attrs also stay on the active link (clicking
	// re-fetches the region). Consumer Attrs spread after the wire
	// attributes, so a consumer-supplied hx-* overrides the action's.
	// Applies to NavLink, MobileNavLink, and therefore Nav, SimpleNav, and
	// MobileMenu.
	Wire *wire.Action
}

// navLinkWireAttrs renders the NavLink Wire action as anchor attributes.
// nil Wire (or an empty-URL action) renders nothing — the link keeps
// plain-href navigation. The action is CLONED with PreventDefault set
// (copy semantics — components never rewrite consumer specs): NavLink is
// always an <a>, and a Datastar-wired anchor with an href would otherwise
// patch AND navigate, because the runtime auto-preventDefaults only
// form+submit (decoded from the pinned v1.0.3 bundle). htmx ignores the
// flag — its engine intercepts wired clicks itself.
func navLinkWireAttrs(w *wire.Action) templ.Attributes {
	if w == nil {
		return nil
	}

	nav := *w
	nav.PreventDefault = true

	return nav.Attributes()
}

// DefaultNavLinkProps returns sensible defaults
func DefaultNavLinkProps() NavLinkProps {
	return NavLinkProps{}
}

// activeSpanOrLink renders a span with aria-current when active, or a link when inactive.
// rel, when non-empty, adds a rel attribute to the <a> (e.g. "canonical", "prev", "next").
templ activeSpanOrLink(isActive bool, href string, text string, activeClass string, inactiveClass string, rel string) {
	if isActive {
		<span aria-current="page" class={ activeClass }>{ text }</span>
	} else {
		<a
			href={ templ.SafeURL(href) }
			class={ inactiveClass }
			if rel != "" {
				rel={ rel }
			}
		>{ text }</a>
	}
}

// navLinkAnchor renders the common anchor element shared by NavLink and
// MobileNavLink. The caller supplies the component-specific base class
// (active/inactive variant); consumer overrides from props.Class are merged
// via utils.Class so conflicting Tailwind utilities resolve correctly.
templ navLinkAnchor(props NavLinkProps, isActive bool, baseClass string) {
	<a
		if props.ID != "" {
			id={ props.ID }
		}
		href={ templ.SafeURL(props.Href) }
		class={ utils.Class(baseClass, props.Class) }
		if isActive {
			aria-current="page"
		}
		if props.External {
			target="_blank"
			rel="noopener noreferrer"
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		{ navLinkWireAttrs(props.Wire)... }
		{ props.Attrs... }
	>
		{ props.Text }
	</a>
}

// NavLink renders a single navigation link with active state styling
//
//	@navigation.NavLink(navigation.NavLinkProps{Href: "/", Text: "Home"}, "/")
templ NavLink(props NavLinkProps, currentPath string) {
	{{ isActive := IsActive(props.Href, currentPath) }}
	@navLinkAnchor(props, isActive, navLinkClasses(isActive))
}

// MobileNavLink renders a mobile-friendly navigation link
//
//	@navigation.MobileNavLink(navigation.NavLinkProps{Href: "/", Text: "Home"}, "/")
templ MobileNavLink(props NavLinkProps, currentPath string) {
	{{ isActive := IsActive(props.Href, currentPath) }}
	@navLinkAnchor(props, isActive, mobileNavLinkClass(isActive))
}
