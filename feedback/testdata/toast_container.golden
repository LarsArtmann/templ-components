<div id="tc-toast-container" class="bottom-4 end-4 fixed flex flex-col gap-2 pointer-events-none z-50" aria-live="polite" aria-atomic="true"><!-- Toasts are injected here --></div><script nonce="test-nonce">var tcToastColors = {'success': {border:'border-green-200 dark:border-green-800',bg:'bg-green-50 dark:bg-green-900/20',text:'text-green-800 dark:text-green-200',icon:'text-green-600 dark:text-green-400'},'error': {border:'border-red-200 dark:border-red-800',bg:'bg-red-50 dark:bg-red-900/20',text:'text-red-800 dark:text-red-200',icon:'text-red-600 dark:text-red-400'},'warning': {border:'border-yellow-200 dark:border-yellow-800',bg:'bg-yellow-50 dark:bg-yellow-900/20',text:'text-yellow-800 dark:text-yellow-200',icon:'text-yellow-600 dark:text-yellow-400'},'info': {border:'border-blue-200 dark:border-blue-800',bg:'bg-blue-50 dark:bg-blue-900/20',text:'text-blue-800 dark:text-blue-200',icon:'text-blue-600 dark:text-blue-400'},};
var tcToastIcons = {'success':'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>','error':'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>','warning':'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.664-.833-2.464 0L4.35 16.5c-.77.833.192 2.5 1.732 2.5z"/>','info':'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/>',dismiss:'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>'};
function tcShowToast(message, type, title, duration) {
var container = document.getElementById('tc-toast-container');
if (!container) return;
var toast = document.createElement('div');
var typeKey = type || 'info';
var style = tcToastColors[typeKey] || tcToastColors.info;
toast.className = 'pointer-events-auto max-w-sm w-full rounded-lg border shadow-lg dark:shadow-black/20 px-4 py-3 transform transition-all duration-300 motion-reduce:transition-none motion-reduce:duration-0 translate-x-full ' + style.border + ' ' + style.bg + ' ' + style.text;
var inner = document.createElement('div');
inner.className = 'flex items-start gap-3';
var svgEl = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
svgEl.setAttribute('class', 'h-5 w-5 flex-shrink-0 mt-0.5 ' + style.icon);
svgEl.setAttribute('fill', 'none');
svgEl.setAttribute('viewBox', '0 0 24 24');
svgEl.setAttribute('stroke', 'currentColor');
svgEl.innerHTML = (tcToastIcons[typeKey] || tcToastIcons.info);
inner.appendChild(svgEl);
var content = document.createElement('div');
content.className = 'flex-1 min-w-0';
if (title) {
var titleEl = document.createElement('div');
titleEl.className = 'text-sm font-semibold';
titleEl.textContent = title;
content.appendChild(titleEl);
}
var msgEl = document.createElement('div');
msgEl.className = 'text-sm';
msgEl.textContent = message;
content.appendChild(msgEl);
inner.appendChild(content);
var btn = document.createElement('button');
btn.className = 'flex-shrink-0 text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-200 transition-colors motion-reduce:transition-none motion-reduce:duration-0';
btn.setAttribute('aria-label', 'Dismiss');
btn.addEventListener('click', function() { this.closest('.pointer-events-auto').remove(); });
btn.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">' + (tcToastIcons.dismiss || '') + '</svg>';
inner.appendChild(btn);
toast.appendChild(inner);
container.appendChild(toast);
requestAnimationFrame(function() { toast.classList.remove('translate-x-full'); });
if (duration && duration > 0) {
setTimeout(function() {
toast.classList.add('translate-x-full');
setTimeout(function() { toast.remove(); }, 300);
}, duration);
}
}</script>