package main

import (
	"strconv"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/layout"
	"github.com/larsartmann/templ-components/utils"
)

// Canonical counts from FEATURES.md ("Totals:" line, drift-guard verified).
// demo_counts_test.go asserts these against FEATURES.md so they cannot drift.
const (
	componentCount = "132"
	packageCount   = "18"
)

// demoHomePage renders the landing page through the shared shell. The hero
// replaces the standard PageHeader (homePageMeta.ShowHeader is false).
templ demoHomePage(nonce string) {
	@demoShell(homePageMeta, nonce, demoHomeContent(nonce))
}

// demoFonts loads the demo's web fonts (Inter, JetBrains Mono, Space
// Grotesk) from Google Fonts.
templ demoFonts(nonce string) {
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
	<link
		href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
		rel="stylesheet"
	/>
}

// demoHomeContent is the landing body: hero, stat cards, and the page
// directory (filterable card grid driven by the page registry).
templ demoHomeContent(nonce string) {
	@demoHero()
	@layout.Container(layout.ContainerProps{BaseProps: utils.BaseProps{Class: "max-w-6xl py-10"}}) {
		<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<h2 class="text-xl font-semibold text-gray-900 dark:text-white font-[Space_Grotesk]">Explore the library</h2>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
					One page per package — every demo below is live and wired to real endpoints.
				</p>
			</div>
			<div class="w-full sm:w-64">
				@forms.Input(forms.InputProps{
					BaseProps: utils.BaseProps{
						ID:        "demo-search",
						Class:     "py-2 text-sm",
						AriaLabel: "Filter demo pages",
					},
					Name:        "demo-search",
					Type:        forms.InputSearch,
					Placeholder: "Filter pages...",
				})
			</div>
		</div>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="demo-cards">
			for _, page := range demoPages() {
				@demoPageCard(page)
			}
		</div>
		@demoHomeStandAlone()
	}
	@demoCardFilterScript()
}

// demoHero is the compact landing hero: version badge, headline, install
// command, and the component/icon/package stat cards.
templ demoHero() {
	<div class="relative overflow-hidden border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
		<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_0%,rgba(59,130,246,0.08),transparent)] dark:bg-[radial-gradient(60%_50%_at_50%_0%,rgba(59,130,246,0.15),transparent)]" aria-hidden="true"></div>
		@layout.Container(layout.ContainerProps{BaseProps: utils.BaseProps{Class: "max-w-6xl py-12 sm:py-16"}}) {
			<div class="flex flex-col items-start gap-6">
				<div class="inline-flex items-center gap-2 rounded-full border border-blue-100 dark:border-blue-900/30 bg-blue-50 dark:bg-blue-950/30 px-3 py-1 text-xs font-medium text-blue-700 dark:text-blue-300">
					@icons.Icon(icons.Star, "h-3.5 w-3.5")
					<span>v{ utils.Version }</span>
					<span class="text-blue-300 dark:text-blue-700" aria-hidden="true">|</span>
					<span>Go 1.26 · templ · Tailwind v4</span>
				</div>
				<div class="max-w-2xl">
					<h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white font-[Space_Grotesk] sm:text-5xl">
						Server-rendered UI components for Go
					</h1>
					<p class="mt-4 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
						{ componentCount } accessible, CSP-safe components built with
						<span class="font-medium text-blue-600 dark:text-blue-400">templ</span>,
						<span class="font-medium text-blue-600 dark:text-blue-400">HTMX</span>, and
						<span class="font-medium text-blue-600 dark:text-blue-400">Tailwind CSS v4</span>.
						No Node.js runtime, no client framework — just Go templates.
					</p>
				</div>
				<div class="flex flex-wrap items-center gap-4">
					@display.CopyButton(display.CopyButtonProps{
						BaseProps: utils.BaseProps{Nonce: demoNonceConst},
						Text:      "go get github.com/larsartmann/templ-components",
						Label:     "Copy install command",
					})
					<a href={ templ.SafeURL(demoDocsURL) } class="inline-flex items-center gap-2 py-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors motion-reduce:transition-none motion-reduce:duration-0">
						Documentation
						@icons.Icon(icons.ExternalLink, "h-4 w-4")
					</a>
				</div>
				<div class="grid w-full max-w-md grid-cols-3 gap-3 sm:max-w-lg sm:gap-4">
					@demoStatCard(componentCount, "Components")
					@demoStatCard(strconv.Itoa(len(icons.AllIconNames())), "Icons")
					@demoStatCard(packageCount, "Packages")
				</div>
			</div>
		}
	</div>
}

// demoHomeStandAlone points at the standalone full-screen pages that live
// outside the shell (recipes rendered edge-to-edge, the way consumers
// compose them).
templ demoHomeStandAlone() {
	<div class="mt-10 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-5">
		<h3 class="text-sm font-semibold text-gray-900 dark:text-white">Full-screen recipes</h3>
		<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
			Standalone screens rendered edge-to-edge:
		</p>
		<div class="mt-3 flex flex-wrap gap-2">
			@demoStandardLink("/recipes/dashboard", "Dashboard")
			@demoStandardLink("/recipes/settings", "Settings")
			@demoStandardLink("/recipes/login", "Login card")
			@demoStandardLink("/recipes/auth", "Auth layout")
			@demoStandardLink("/errors/playground", "Error playground")
		</div>
	</div>
}

// demoStandardLink is a compact pill link to a standalone page.
templ demoStandardLink(href, label string) {
	<a
		href={ templ.SafeURL(demoURL(href)) }
		class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 hover:border-blue-300 dark:hover:border-blue-700 hover:text-blue-600 dark:hover:text-blue-400 transition-colors motion-reduce:transition-none motion-reduce:duration-0"
	>
		{ label }
		@icons.Icon(icons.ArrowRight, "h-3 w-3")
	</a>
}

// demoStatCard is the hero metric tile.
templ demoStatCard(value string, label string) {
	<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50 p-4 text-center">
		<div class="text-2xl font-bold text-gray-900 dark:text-white font-[Space_Grotesk] sm:text-3xl">{ value }</div>
		<div class="mt-1 text-xs text-gray-500 dark:text-gray-400 sm:text-sm">{ label }</div>
	</div>
}

// demoPageCard is one directory card: icon, title, description, arrow. The
// card filter script matches on the card's text content.
templ demoPageCard(page demoPageMeta) {
	<a
		href={ templ.SafeURL(page.canonicalPath()) }
		class="demo-card group flex flex-col rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-md dark:hover:shadow-black/20 transition-all motion-reduce:transition-none motion-reduce:duration-0"
	>
		<div class="flex items-start justify-between gap-3">
			<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400">
				@icons.Icon(page.Icon, "h-5 w-5")
			</span>
			@icons.Icon(icons.ArrowRight, "h-4 w-4 text-gray-300 dark:text-gray-600 group-hover:text-blue-500 dark:group-hover:text-blue-400 group-hover:translate-x-0.5 transition-all motion-reduce:transition-none motion-reduce:duration-0 motion-reduce:translate-x-0")
		</div>
		<p class="mt-4 font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors motion-reduce:transition-none motion-reduce:duration-0">{ page.Title }</p>
		<p class="mt-1 text-sm leading-relaxed text-gray-500 dark:text-gray-400">{ page.Short }</p>
	</a>
}

// demoCardFilterScript wires the home filter input to the page cards: a
// case-insensitive substring match over each card's text, hiding non-matches.
templ demoCardFilterScript() {
	<script nonce={ demoNonceConst }>
		document.addEventListener('DOMContentLoaded', function() {
			var input = document.getElementById('demo-search');
			if (!input) return;
			var cards = document.querySelectorAll('.demo-card');
			input.addEventListener('input', function() {
				var term = input.value.trim().toLowerCase();
				cards.forEach(function(card) {
					var match = !term || card.textContent.toLowerCase().indexOf(term) !== -1;
					card.style.display = match ? '' : 'none';
				});
			});
		});
	</script>
}

// demoSection wraps one demo block with an anchored heading. Section pages
// compose several of these; the id doubles as a deep-link target.
templ demoSection(title, anchor string) {
	<section class="demo-section scroll-mt-24" id={ anchor }>
		<div class="flex items-center justify-between mb-6">
			<h2 class="text-lg font-semibold text-gray-900 dark:text-white font-mono tracking-tight">
				<span class="text-blue-500 dark:text-blue-400">#</span> { title }
			</h2>
		</div>
		<div class="space-y-4">
			{ children... }
		</div>
	</section>
}

// demoCodeSnippet shows a Go/HTML snippet with a copy button.
templ demoCodeSnippet(title, code string) {
	<div class="mt-4 rounded-lg border border-gray-200 dark:border-gray-800 bg-gray-900 dark:bg-gray-950 text-gray-100 dark:text-gray-100 overflow-hidden">
		<div class="flex items-center justify-between px-3 py-2 border-b border-gray-800 dark:border-gray-700 bg-gray-950 dark:bg-gray-900">
			<span class="text-xs font-mono text-gray-400 dark:text-gray-500">{ title }</span>
			@display.CopyButton(display.CopyButtonProps{
				BaseProps: utils.BaseProps{
					Class: "text-gray-300 dark:text-gray-400 hover:text-white dark:hover:text-white border-gray-700 dark:border-gray-600 hover:bg-gray-800 dark:hover:bg-gray-700",
					Nonce: demoNonceConst,
				},
				Text:  code,
				Label: "Copy",
			})
		</div>
		<pre tabindex="0" aria-label="Code example" class="p-3 text-xs sm:text-sm font-mono overflow-x-auto"><code>{ code }</code></pre>
	</div>
}

// recipesDemo links the standalone full-screen recipe pages.
templ recipesDemo() {
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		@recipeLinkCard("/recipes/dashboard", "Dashboard", "recipes.Dashboard — stat cards + charts composition.", icons.Squares2x2)
		@recipeLinkCard("/recipes/settings", "Settings", "recipes.SettingsLayout — aside nav + section cards.", icons.Settings)
		@recipeLinkCard("/recipes/login", "Login card", "recipes.LoginCard — centered sign-in card.", icons.UserCircle)
		@recipeLinkCard("/recipes/auth", "Auth layout", "recipes.AuthLayout — split-screen branding + auth card.", icons.ShieldCheck)
		@recipeLinkCard("/errors/playground", "Error playground", "Live ErrorPage builder — pick a family and status.", icons.Wrench)
	</div>
}

// recipeLinkCard is one recipe link tile.
templ recipeLinkCard(href, title, description string, icon icons.Name) {
	<a
		href={ templ.SafeURL(demoURL(href)) }
		class="group rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-md dark:hover:shadow-black/20 transition-all motion-reduce:transition-none motion-reduce:duration-0"
	>
		<div class="flex items-start gap-4">
			<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400">
				@icons.Icon(icon, "h-5 w-5")
			</span>
			<div>
				<p class="font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors motion-reduce:transition-none motion-reduce:duration-0">{ title }</p>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{ description }</p>
			</div>
		</div>
	</a>
}
