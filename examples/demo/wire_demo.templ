package main

import (
	"fmt"
	"strings"
	"time"

	"github.com/larsartmann/templ-components/datastar"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/utils"
	"github.com/larsartmann/templ-components/utils/wire"
)

// wireDemo showcases the transport-agnostic wiring contract: one wire.Action
// spec rendered as htmx or Datastar attributes depending on the configured
// Transport. The endpoint is shared: wire.Handler detects the caller via
// request headers and tells Datastar where to patch via response headers
// (htmx targets client-side through hx-target).
//
// The transport selector (?transport=both|htmx|datastar) flips every button's
// dialect — the SDK pitch: the Action stays identical, one field switches the
// runtime.
templ wireDemo(transport demoTransport) {
	@forms.DirtyGuard(forms.DirtyGuardProps{})
	@demoSection("Wire — One Action, Both Transports", "wire-transport")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
		Every button here is the same <code>display.Button</code> with the same
		<code>wire.Action</code> shape — only the Transport differs. The endpoint is
		shared: it detects the caller via request headers and tells Datastar where to
		patch via response headers (htmx targets client-side through <code>hx-target</code>).
		Use the selector to flip every button's dialect:
	</p>
	<div class="inline-flex rounded-md border border-gray-300 dark:border-gray-700 overflow-hidden mb-3" role="group" aria-label="Transport selector">
		@wireTransportLink("Both", demoTransportBoth, transport)
		@wireTransportLink("HTMX", demoTransportHTMX, transport)
		@wireTransportLink("Datastar", demoTransportDatastar, transport)
	</div>
	@demoCodeSnippet(
		"Go",
		`&wire.Action{URL: "/api/wire/fragment", Target: "#out"}                 // hx-get="/api/wire/fragment" + hx-target
&wire.Action{Transport: wire.TransportDatastar, URL: "/api/wire/fragment"} // data-on:click="@get('/api/wire/fragment')"`,
	)
	if transport == demoTransportBoth {
		@display.Grid(display.GridProps{
			BaseProps: utils.BaseProps{Class: "mt-4"},
			Cols:      display.GridCols2,
			Gap:       display.GridGapMD,
		}) {
			<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4">
				<h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">HTMX transport</h3>
				@display.Button(display.ButtonProps{
					Text:    "Load via htmx",
					Variant: display.ButtonSecondary,
					Size:    display.ButtonSizeSM,
					Wire: &wire.Action{
						URL:    "/api/wire/fragment",
						Target: "#wire-htmx-out",
					},
				})
				<div id="wire-htmx-out" class="mt-3"></div>
			</div>
			<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4">
				<h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Datastar transport</h3>
				@display.Button(display.ButtonProps{
					Text:    "Load via Datastar",
					Variant: display.ButtonSecondary,
					Size:    display.ButtonSizeSM,
					Wire: &wire.Action{
						Transport: wire.TransportDatastar,
						URL:       "/api/wire/fragment",
					},
				})
				<div id="wire-datastar-out" class="mt-3"></div>
			</div>
		}
	} else {
		<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4 mt-4">
			<h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">
				if transport == demoTransportHTMX {
					HTMX transport (all buttons)
				} else {
					Datastar transport (all buttons)
				}
			</h3>
			@display.Button(display.ButtonProps{
				Text:    "Load via " + transport.humanName(),
				Variant: display.ButtonSecondary,
				Size:    display.ButtonSizeSM,
				Wire: &wire.Action{
					Transport: transport.wireTransport(),
					URL:       "/api/wire/fragment",
					Target:    transport.wireTarget(),
				},
			})
			<div id={ transport.outID() } class="mt-3"></div>
		</div>
	}
	<p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
		Note the Datastar button carries no target attribute: Datastar fetch actions (v1.0.2 audited)
		have no target option — the region is chosen by the response (<code>Datastar-Selector</code>)
		or by matching fragment ids. wire.Action.Target documents this contract and renders
		only for htmx. The endpoint is wrapped in <code>wire.Handler</code>, which does the
		response-header targeting for you.
	</p>

	<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4 mt-4">
		<h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Server validation</h3>
		<p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
			A <code>forms.Input</code> wired with <code>EventChange</code>: the field's value
			travels to <code>/api/wire/validate</code> and the verdict patch lands in the region
			below. Under htmx the input carries its own name/value; under Datastar the static-URL
			common subset cannot carry the value, so the demo uses the documented
			<code>Attrs</code> escape hatch with a bound signal.
		</p>
		<div class="max-w-md">
			@wireDemoValidateInput(transport)
			<div id="wire-validate-out" class="mt-3" aria-live="polite"></div>
		</div>
	</div>

	<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4 mt-4">
		<h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Dual-transport form</h3>
		<p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
			The same <code>forms.Form</code> submitting under either runtime. The form's fields
			serialize in both dialects: htmx natively (<code>hx-post</code> + implicit submit
			trigger), Datastar via the <code>contentType form</code> option on the submit
			expression — a pinned v1.0.3 runtime capability that also runs HTML5 validation and
			carries the submit button's name/value. One handler serves both.
		</p>
		@demoCodeSnippet(
			"Go",
			`&wire.Action{Method: wire.MethodPost, URL: "/api/wire/form", Target: "#wire-form-htmx-region"} // hx-post + hx-target
&wire.Action{Transport: wire.TransportDatastar, Method: wire.MethodPost, URL: "/api/wire/form"} // data-on:submit="@post(…, {contentType: 'form'})"`,
		)
		<div class="max-w-md">
			if transport == demoTransportBoth {
				<div class="space-y-6">
					<div id="wire-form-htmx-region" aria-live="polite">
						@wireDemoForm(wire.TransportHTMX, wireFormState{})
					</div>
					<div id="wire-form-out" aria-live="polite">
						@wireDemoForm(wire.TransportDatastar, wireFormState{})
					</div>
				</div>
			} else if transport.wireTransport() == wire.TransportDatastar {
				<div id="wire-form-out" aria-live="polite">
					@wireDemoForm(wire.TransportDatastar, wireFormState{})
				</div>
			} else {
				<div id="wire-form-htmx-region" aria-live="polite">
					@wireDemoForm(wire.TransportHTMX, wireFormState{})
				</div>
			}
		</div>
		<p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
			Submit invalid data (an email without a domain): the server re-renders the form with a
			<code>ValidationSummary</code> and inline field errors, preserving what you typed — on either
			runtime. Valid data renders the success verdict plus a fresh form. Errors travel as 200 OK:
			htmx 2's default response handling does not swap 4xx responses, and Datastar dispatches a
			fetch error event at status >= 400 — 200 keeps both zero-config.
		</p>
	</div>

	<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4 mt-4">
		<h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Debounced filter</h3>
		<p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
			<code>forms.FilterInput</code>: a <code>&lt;search&gt;</code> form whose input auto-submits
			as you type, debounced 300ms. Under htmx it renders
			<code>hx-trigger="input changed delay:300ms"</code>; under Datastar
			<code>data-on:input__debounce.300ms</code> (the modifier spelling decoded from the pinned
			bundle) with the form encoding path — so the query travels as a clean <code>?q=</code>
			parameter on either runtime. One endpoint serves both via <code>wire.Handler</code>.
		</p>
		@demoCodeSnippet(
			"Go",
			`&wire.Action{URL: "/api/wire/filter", Target: "#wire-filter-out"} // hx-trigger="input changed delay:300ms"
&wire.Action{Transport: wire.TransportDatastar, URL: "/api/wire/filter"} // data-on:input__debounce.300ms`,
		)
		<div class="max-w-md">
			if transport == demoTransportBoth {
				<div class="space-y-6">
					<div>
						<p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">HTMX</p>
						@wireDemoFilterInput(wire.TransportHTMX)
					</div>
					<div>
						<p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Datastar</p>
						@wireDemoFilterInput(wire.TransportDatastar)
					</div>
				</div>
			} else {
				@wireDemoFilterInput(transport.wireTransport())
			}
			<div id="wire-filter-out" class="mt-3" aria-live="polite">
				@wireFilterResults("")
			</div>
		</div>
	</div>

	<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4 mt-4">
		<h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Busy state</h3>
		<p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
			Perceived performance on wired submits. htmx swaps to a <code>LoadingButton</code>
			during the request; Datastar toggles an <code>Indicator</code> via the
			<code>data-indicator</code> signal (composed on the same wired
			<code>display.Button</code> through <code>Attrs</code>). The endpoint sleeps 800ms
			so the busy state is actually visible.
		</p>
		if transport == demoTransportBoth {
			@display.Grid(display.GridProps{
				Cols: display.GridCols2,
				Gap:  display.GridGapMD,
			}) {
				<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4">
					<h4 class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-2">HTMX</h4>
					@wireBusyButtonHTMX()
					<div id="wire-busy-htmx-out" class="mt-3" aria-live="polite"></div>
				</div>
				<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4">
					<h4 class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-2">Datastar</h4>
					@wireBusyButtonDatastar()
					<div id="wire-busy-datastar-out" class="mt-3" aria-live="polite"></div>
				</div>
			}
		} else if transport.wireTransport() == wire.TransportDatastar {
			@wireBusyButtonDatastar()
			<div id="wire-busy-datastar-out" class="mt-3" aria-live="polite"></div>
		} else {
			@wireBusyButtonHTMX()
			<div id="wire-busy-htmx-out" class="mt-3" aria-live="polite"></div>
		}
	</div>

	<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4 mt-4">
		<h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">File upload</h3>
		<p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
			The classic hypermedia wallflower: <code>Enctype: forms.FormEnctypeMultipart</code>
			on a wired <code>forms.Form</code> with a <code>FileInput</code>. htmx serializes the
			FormData natively; the pinned Datastar bundle sends a FormData body exactly when
			enctype is multipart. The endpoint echoes the file's name and size into the region
			below — errors travel as 200 OK fragments (the validation rule).
		</p>
		@demoCodeSnippet(
			"Go",
			`forms.FormProps{Method: forms.FormPost, Enctype: forms.FormEnctypeMultipart,
	Wire: &wire.Action{Method: wire.MethodPost, URL: "/api/wire/upload"}}`,
		)
		<div class="max-w-md">
			if transport == demoTransportBoth {
				<div class="space-y-6">
					<div>
						<p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">HTMX</p>
						@wireUploadForm(wire.TransportHTMX)
					</div>
					<div>
						<p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Datastar</p>
						@wireUploadForm(wire.TransportDatastar)
					</div>
				</div>
			} else {
				@wireUploadForm(transport.wireTransport())
			}
			<div id="wire-upload-out" class="mt-3" aria-live="polite"></div>
		</div>
	</div>

	<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4 mt-4">
		<h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">GET search form</h3>
		<p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
			Search-as-a-GET: a <code>forms.Form</code> with <code>Method: forms.FormGet</code> and a
			wired submit. Under htmx the fields ride the query string natively; under Datastar a
			GET with <code>contentType: 'form'</code> carries the fields as query parameters too —
			identical URLs, one endpoint.
		</p>
		<div class="max-w-md">
			if transport == demoTransportBoth {
				<div class="space-y-6">
					<div id="wire-search-htmx-region" aria-live="polite">
						@wireSearchForm(wire.TransportHTMX, "")
					</div>
					<div id="wire-search-datastar-region" aria-live="polite">
						@wireSearchForm(wire.TransportDatastar, "")
					</div>
				</div>
			} else if transport.wireTransport() == wire.TransportDatastar {
				<div id="wire-search-datastar-region" aria-live="polite">
					@wireSearchForm(wire.TransportDatastar, "")
				</div>
			} else {
				<div id="wire-search-htmx-region" aria-live="polite">
					@wireSearchForm(wire.TransportHTMX, "")
				</div>
			}
		</div>
	</div>
}

// wireUploadForm renders the wired multipart upload form in the given
// dialect. Both dialects share the #wire-upload-out results region.
templ wireUploadForm(dialect wire.Transport) {
	@forms.Form(forms.FormProps{
		Action:  "/api/wire/upload",
		Method:  forms.FormPost,
		Enctype: forms.FormEnctypeMultipart,
		BaseProps: utils.BaseProps{
			Class: "space-y-3",
		},
		Wire: &wire.Action{
			Transport: dialect,
			Method:    wire.MethodPost,
			URL:       "/api/wire/upload",
			Target:    utils.Ternary(dialect == wire.TransportDatastar, "", "#wire-upload-out"),
		},
	}) {
		@forms.FileInput(forms.FileInputProps{Name: "attachment", Label: "Attachment"})
		@display.Button(display.ButtonProps{
			Text:    "Upload",
			Variant: display.ButtonPrimary,
			Size:    display.ButtonSizeSM,
			Type:    display.ButtonHTMLSubmit,
		})
	}
}

// wireUploadResult is the shared response body for the upload endpoint:
// the file's name and size, or an inline error fragment (200 OK — the
// validation rule keeps both runtimes swapping).
templ wireUploadResult(name string, size int64, transport string) {
	if name == "" {
		@feedback.InlineError("No attachment received — choose a file and try again.")
	} else {
		@feedback.InlineSuccess("Uploaded “" + name + "” (" + wireFormatBytes(size) + ") via " + transport + ".")
	}
}

// wireFormatBytes renders a byte count for the upload result fragment.
func wireFormatBytes(n int64) string {
	switch {
	case n >= 1<<20:
		return fmt.Sprintf("%.1f MiB", float64(n)/(1<<20))
	case n >= 1<<10:
		return fmt.Sprintf("%.1f KiB", float64(n)/(1<<10))
	default:
		return fmt.Sprintf("%d B", n)
	}
}

// wireSearchForm renders the wired GET search form in the given dialect.
// The form re-renders inside its region: the endpoint echoes the query and
// appends a fresh form, so a correction resubmits in place.
templ wireSearchForm(dialect wire.Transport, query string) {
	@forms.Form(forms.FormProps{
		Action: "/api/wire/search",
		Method: forms.FormGet,
		BaseProps: utils.BaseProps{
			Class: "flex flex-wrap items-end gap-3",
		},
		Wire: &wire.Action{
			Transport: dialect,
			Method:    wire.MethodGet,
			URL:       "/api/wire/search",
			Target:    utils.Ternary(dialect == wire.TransportDatastar, "", wireSearchRegionID(dialect)),
		},
	}) {
		@forms.Input(forms.InputProps{
			Name:        "q",
			Type:        forms.InputSearch,
			Label:       "Search",
			Value:       query,
			Placeholder: "Try: ada",
		})
		@display.Button(display.ButtonProps{
			Text:    "Search",
			Variant: display.ButtonSecondary,
			Size:    display.ButtonSizeSM,
			Type:    display.ButtonHTMLSubmit,
		})
	}
}

// wireSearchRegionID returns the swap region for the GET search form in the
// given dialect (empty under Datastar — response-driven targeting).
func wireSearchRegionID(dialect wire.Transport) string {
	if dialect == wire.TransportDatastar {
		return ""
	}

	return "#wire-search-htmx-region"
}

// wireSearchResult is the re-rendered region for the GET search endpoint:
// the echoed query plus a fresh wired form (the round-trip pattern).
templ wireSearchResult(dialect wire.Transport, query string) {
	if query == "" {
		<p class="text-sm text-gray-500 dark:text-gray-400">Type a query and submit — the fields travel as query parameters on either runtime.</p>
		@wireSearchForm(dialect, query)
	} else {
		@feedback.InlineSuccess("GET received q=“" + query + "” via " + wireSearchTransportName(dialect) + ".")
		@wireSearchForm(dialect, query)
	}
}

// wireSearchTransportName names the dialect for the search result fragment.
func wireSearchTransportName(dialect wire.Transport) string {
	if dialect == wire.TransportDatastar {
		return "datastar"
	}

	return "htmx"
}

// wireBusyButtonHTMX renders the htmx busy-state button: a plain button
// element wrapping htmx.LoadingButton — the default label hides and the
// "Running…" label + spinner appear while the button carries .htmx-request.
templ wireBusyButtonHTMX() {
	<button
		class="inline-flex items-center rounded-md bg-blue-600 dark:bg-blue-500 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors motion-reduce:transition-none motion-reduce:duration-0"
		hx-post="/api/wire/busy"
		hx-target="#wire-busy-htmx-out"
		hx-swap="innerHTML"
	>
		@htmx.LoadingButton("Run job", "Running…", feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM, Color: "text-white"}))
	</button>
}

// wireBusyButtonDatastar renders the Datastar busy-state button: the wired
// display.Button composes with a data-indicator signal via Attrs, and
// datastar.Indicator shows while the fetch runs (role="status").
templ wireBusyButtonDatastar() {
	<div class="flex items-center gap-3">
		@display.Button(display.ButtonProps{
			Text:    "Run job",
			Variant: display.ButtonPrimary,
			Size:    display.ButtonSizeSM,
			Wire: &wire.Action{
				Transport: wire.TransportDatastar,
				Method:    wire.MethodPost,
				URL:       "/api/wire/busy",
				Selector:  "#wire-busy-datastar-out",
			},
			BaseProps: utils.BaseProps{
				Attrs: templ.Attributes{"data-indicator:saving": true},
			},
		})
		@datastar.Indicator(datastar.IndicatorProps{
			Signal:    "saving",
			BaseProps: utils.BaseProps{AriaLabel: "Running job"},
		})
	</div>
}

// wireDemoValidateInput wires the validation input in the selected dialect:
// the typed wire contract under htmx (hx-get + hx-trigger="change"), the
// Attrs escape hatch with a bound signal under Datastar.
templ wireDemoValidateInput(transport demoTransport) {
	if transport.wireTransport() == wire.TransportDatastar {
		@forms.Input(forms.InputProps{
			Name:        "value",
			Type:        forms.InputEmail,
			Label:       "Email address",
			Placeholder: "you@example.com",
			BaseProps: utils.BaseProps{
				Attrs: templ.Attributes{
					"data-bind:value": "",
					"data-on:change":  "@get('/api/wire/validate?value=' + encodeURIComponent($value || ''))",
				},
			},
		})
	} else {
		@forms.Input(forms.InputProps{
			Name:        "value",
			Type:        forms.InputEmail,
			Label:       "Email address",
			Placeholder: "you@example.com",
			BaseProps: utils.BaseProps{
				Attrs: wireValidateAttrs(),
			},
		})
	}
}

// wireValidateResult is the validation verdict fragment.
templ wireValidateResult(message string, ok bool) {
	if ok {
		@feedback.InlineSuccess(message)
	} else {
		@feedback.InlineError(message)
	}
}

// wireFormState carries a subscribe form's submitted values and server-side
// validation verdicts — the round-trip state the endpoint re-renders.
type wireFormState struct {
	Name     string
	Email    string
	NameErr  string
	EmailErr string
}

func (s wireFormState) invalid() bool {
	return s.NameErr != "" || s.EmailErr != ""
}

func (s wireFormState) summaryErrors() []forms.ValidationError {
	errs := make([]forms.ValidationError, 0, 2)
	if s.NameErr != "" {
		errs = append(errs, forms.ValidationError{Field: "name", Message: s.NameErr})
	}
	if s.EmailErr != "" {
		errs = append(errs, forms.ValidationError{Field: "email", Message: s.EmailErr})
	}

	return errs
}

// wireDemoForm wires a subscribe form in the given dialect. The fields
// serialize under both transports (htmx natively; Datastar via
// contentType:'form' — the Form component applies that default), and the
// form renders inside its swap region so the endpoint's re-render (errors
// inline, values preserved — or the success verdict plus a fresh form)
// replaces it wholesale. The htmx dialect carries hx-target; Datastar
// targeting is response-driven via wire.Handler.
templ wireDemoForm(dialect wire.Transport, st wireFormState) {
	if errs := st.summaryErrors(); len(errs) > 0 {
		@forms.ValidationSummary(forms.ValidationSummaryProps{Errors: errs})
	}
	@forms.Form(forms.FormProps{
		DirtyGuard: true,
		Method: forms.FormPost,
		Wire: &wire.Action{
			Transport: dialect,
			Method:    wire.MethodPost,
			URL:       "/api/wire/form",
			Target:    utils.Ternary(dialect == wire.TransportHTMX, "#wire-form-htmx-region", ""),
		},
	}) {
		@forms.Input(forms.InputProps{
			Name:        "name",
			Label:       "Name",
			Placeholder: "Ada Lovelace",
			Value:       st.Name,
			Error:       st.NameErr,
		})
		@forms.Input(forms.InputProps{
			Name:  "email",
			Type:  forms.InputEmail,
			Label: "Email address",
			Value: st.Email,
			Error: st.EmailErr,
		})
		<div>
			@display.Button(display.ButtonProps{
				Text:    "Subscribe",
				Type:    display.ButtonHTMLSubmit,
				Size:    display.ButtonSizeSM,
				Variant: display.ButtonPrimary,
			})
		</div>
	}
}

// wireFormVerdict is the form-submission success verdict: it proves the
// form's fields traveled under the active transport by echoing them back.
templ wireFormVerdict(name, email, transport string) {
	@feedback.InlineSuccess("Subscribed " + name + " (" + email + ") via " + transport + ".")
}

// wireTransportLink renders one segmented-control option as a plain link
// (CSP-safe, no JS). The active option gets inverted colors.
templ wireTransportLink(label string, value demoTransport, active demoTransport) {
	if value == active {
		<a href={ templ.URL("?transport=" + string(value) + "#wire-transport") } class="px-3 py-1.5 text-sm font-medium bg-blue-600 dark:bg-blue-500 text-white" aria-current="true">{ label }</a>
	} else {
		<a href={ templ.URL("?transport=" + string(value) + "#wire-transport") } class="px-3 py-1.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">{ label }</a>
	}
}

// wireFragment is the shared response body for both wire demo transports.
templ wireFragment(loadedAt string) {
	@feedback.InlineSuccess("Fragment loaded via the transport-agnostic wire contract at " + loadedAt)
}

// wireDemoFilterInput renders the debounced filter input in the given
// dialect. Both dialects target the shared #wire-filter-out region: htmx
// client-side via Wire.Target, Datastar via the wire.Handler response
// headers.
templ wireDemoFilterInput(dialect wire.Transport) {
	@forms.FilterInput(forms.FilterInputProps{
		Name:        "q",
		Label:       "Filter frameworks",
		Placeholder: "Type to filter…",
		HelpText:    "Debounced 300ms — results update as you type",
		DebounceMS:  300,
		Wire: &wire.Action{
			Transport: dialect,
			URL:       "/api/wire/filter",
			Target:    utils.Ternary(dialect == wire.TransportDatastar, "", "#wire-filter-out"),
		},
	})
}

// wireFilterDataset is the static demo dataset for the debounced filter.
var wireFilterDataset = []string{"Alpine.js", "Datastar", "Htmx", "Hyperscript", "Tailwind", "Templ"}

// wireFilterMatches returns the dataset entries containing the query
// (case-insensitive). An empty query matches everything.
func wireFilterMatches(query string) []string {
	query = strings.ToLower(strings.TrimSpace(query))
	if query == "" {
		return wireFilterDataset
	}

	var out []string
	for _, name := range wireFilterDataset {
		if strings.Contains(strings.ToLower(name), query) {
			out = append(out, name)
		}
	}

	return out
}

// wireFilterResults is the shared response body for the debounced filter
// endpoint (both transports).
templ wireFilterResults(query string) {
	if len(wireFilterMatches(query)) == 0 {
		<p class="text-sm text-gray-500 dark:text-gray-400">No matches for “{ query }”.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700 text-sm text-gray-900 dark:text-white">
			for _, name := range wireFilterMatches(query) {
				<li class="py-1.5">{ name }</li>
			}
		</ul>
	}
}

// wireBusyDelay makes the busy state visible to humans and e2e drivers.
const wireBusyDelay = 800 * time.Millisecond

// wireUploadMaxBytes caps the demo upload endpoint's request body (8 MiB).
const wireUploadMaxBytes int64 = 8 << 20

// wireBusyDone is the shared response body for the busy-state endpoint.
templ wireBusyDone(transport string) {
	@feedback.InlineSuccess("Job finished via " + transport + " — swapped into this region while the button showed its busy state.")
}
