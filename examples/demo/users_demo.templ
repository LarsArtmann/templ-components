package main

import (
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/navigation"
)

// usersDemoList renders the users list page body (inside the demo shell).
// The sort/pagination state arrives as query params; the page links are
// base-path prefixed so the round trip stays on the canonical /demo origin.
templ usersDemoList(sortKey string, sortDir display.SortDirection, page, totalPages uint) {
	@navigation.Breadcrumbs(navigation.BreadcrumbsProps{Items: []navigation.BreadcrumbItem{
		{Text: "Home", Href: demoURL("/")},
		{Text: "Users"},
	}})
	<div class="mt-6">
		@display.Card(display.CardProps{Title: "Team members", Padding: display.CardPaddingNone}) {
			@display.DataTable(display.DataTableProps{
				Columns: []display.DataTableColumn{
					{Label: "Name", Sortable: true},
					{Label: "Email", Sortable: true, SortKey: "email"},
					{Label: "Role"},
					{Label: "Status"},
				},
				ActiveSortColumn: usersSortColumnLabel(sortKey),
				ActiveSortDir:    sortDir,
				SortBaseURL:      demoURL("/users"),
				Rows:             demoUserRows(pageDemoUsers(sortDemoUsers(demoUsers(), sortKey, sortDir), int(page))),
				Flush:            true,
				Hover:            true,
				Striped:          true,
				Pagination: navigation.Pagination(navigation.PaginationProps{
					CurrentPage: page,
					TotalPages:  totalPages,
					BaseURL:     demoURL("/users"),
				}),
			})
		}
	</div>
}

// filteredUsersFragment is the /api/users response for the FilterDropdown
// demos: a filtered + sorted user list swapped into the results target.
templ filteredUsersFragment(status, sortKey string) {
	<div class="space-y-1">
		{{ filtered := filterDemoUsers(status, sortKey) }}
		if len(filtered) == 0 {
			<p class="text-sm text-gray-500 dark:text-gray-400">No users match the current filters.</p>
		} else {
			for _, u := range filtered {
				<p class="text-sm text-gray-700 dark:text-gray-300">
					{ u.name } <span class="text-gray-400 dark:text-gray-500">·</span>
					<span class="text-gray-500 dark:text-gray-400">{ u.email }</span>
				</p>
			}
		}
	</div>
}
