package main

import (
	"fmt"
	"strconv"
	"time"

	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/htmx"
	"github.com/larsartmann/templ-components/utils"
)

templ htmxDemo() {
	@demoSection("HTMX LoadingIndicator", "htmx-loading-indicator")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Global HTMX loading overlay (shows during any htmx request — try any button below):</p>
	@htmx.LoadingIndicator(feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerMD, Color: "text-blue-600 dark:text-blue-400"}))
	@demoSection("HTMX InlineLoadingOverlay", "htmx-inline-overlay")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Per-target loading indicator (shown via <code>hx-indicator</code>):</p>
	@htmx.InlineLoadingOverlay("demo-form-loading", feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM, Color: "text-white"}))
	@demoSection("HTMX LoadingButton", "htmx-loading-button")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Click — the button swaps to its loading state during the request:</p>
	<button
		hx-post="/api/save"
		hx-swap="none"
		class="inline-flex items-center rounded-md bg-blue-600 dark:bg-blue-500 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors motion-reduce:transition-none motion-reduce:duration-0"
	>
		@htmx.LoadingButton("Save changes", "Saving...", feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM, Color: "text-white"}))
	</button>
	@demoSection("HTMX ConfirmDelete", "htmx-confirm-delete")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Deletes the item below via HTMX after a confirmation dialog:</p>
	<div id="item-123" class="max-w-md">
		<div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 flex items-center justify-between gap-4">
			<div>
				<p class="text-sm font-medium text-gray-900 dark:text-white">item-123</p>
				<p class="text-xs text-gray-500 dark:text-gray-400">Delete me — the row is replaced by the server response.</p>
			</div>
			@htmx.ConfirmDelete(htmx.ConfirmDeleteProps{
				Delete:  "/api/items/123",
				Target:  "#item-123",
				Confirm: "Are you sure you want to delete this item?",
			})
		</div>
	</div>
	@demoSection("HTMX CSRFToken", "htmx-csrf")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Renders a hidden CSRF input field:</p>
	@htmx.CSRFToken("demo-csrf-token-value")
	@demoSection("HTMX SwapOOB", "htmx-swap-oob")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Out-of-band swap element (processed by HTMX after a response):</p>
	<div class="mb-2 text-xs font-mono text-gray-500 dark:text-gray-400">target: <span id="oob-target">current value</span></div>
	@htmx.SwapOOB(htmx.SwapOOBProps{SwapStyle: htmx.SwapOuterHTML, Selector: "#oob-target"})
	@demoSection("HTMX GlobalErrorHandling", "htmx-error-handling")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Wires up htmx:responseError and htmx:beforeOnError events:</p>
	@htmx.GlobalErrorHandling(htmx.DefaultErrorHandlingConfig())
	@demoSection("HTMX ViewTransitions", "htmx-view-transitions")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
		Enables native <a href="https://developer.mozilla.org/en-US/docs/Web/API/View_Transitions_API" class="text-blue-600 dark:text-blue-400 hover:underline">View Transitions</a> on HTMX swaps —
		pages cross-fade instead of hard-cutting, with graceful degradation in browsers without support.
	</p>
	@htmx.ViewTransitions(htmx.ViewTransitionsProps{Global: true, BaseProps: utils.BaseProps{Nonce: "demo-nonce"}})
	@demoCodeSnippet("Go", `htmx.ViewTransitions(htmx.ViewTransitionsProps{Global: true, Nonce: nonce})`)
	@demoSection("HTMX PolledRegion", "htmx-polled-region")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Auto-refreshing region polling <code>/api/demo-stats</code> every 5s (stops after 3 ticks):</p>
	@polledStatsRegion(0)
}

// polledStatsRegion is the PolledRegion demo for both the initial render and
// the /api/demo-stats response. The region swaps itself with outerHTML, so
// the response re-arms the poll with the next tick until the final tick,
// which is returned without polling so the demo settles.
templ polledStatsRegion(tick int) {
	if tick < 3 {
		@htmx.PolledRegion(htmx.PolledRegionProps{
			URL:   "/api/demo-stats?tick=" + strconv.Itoa(tick),
			Every: "5s",
		}) {
			@polledStatsContent(tick, true)
		}
	} else {
		@polledStatsContent(tick, false)
	}
}

templ polledStatsContent(tick int, live bool) {
	<div class="rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-4 flex items-center gap-4">
		<div class="flex-1">
			<p class="text-sm font-medium text-gray-900 dark:text-white">Requests served: { fmt.Sprintf("%d", 48_210+tick*137) }</p>
			<p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Updated { time.Now().Format("15:04:05") } UTC</p>
		</div>
		if live {
			<span class="inline-flex items-center gap-1.5 text-xs text-blue-600 dark:text-blue-400">
				@feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM, Color: "text-blue-600 dark:text-blue-400"})
				auto-refreshing
			</span>
		} else {
			<span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">up to date</span>
		}
	</div>
}
