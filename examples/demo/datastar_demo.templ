package main

import (
	"fmt"
	"strconv"
	"time"

	"github.com/larsartmann/templ-components/datastar"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
)

templ datastarDemo() {
	@demoSection("Datastar SDKScript", "datastar-sdk-script")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
		Injects the Datastar runtime as an ES module. Load once per page:
	</p>
	@datastar.SDKScript(datastar.SDKScriptProps{BaseProps: demoBaseProps()})
	@demoSection("Datastar LiveRegion", "datastar-live-region")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
		SSE-powered region that auto-connects on page load and self-heals across
		server restarts (<code>retry: 'always'</code>). The server pushes
		<code>datastar-patch-elements</code> events to patch the content in real-time
		(no polling). The stream also sends invisible 15s keep-alive comment frames
		(<code>: ping</code>) so proxies and firewalls keep the connection open —
		the "streamed at" timestamps below are the visible proof of liveness:
	</p>
	@datastar.LiveRegion(datastar.LiveRegionProps{
		BaseProps: demoBaseProps(),
		URL:       demoURL("/api/datastar/stream"),
		AutoStart: true,
		Retry:     datastar.RetryAlways,
	}) {
		<div id="datastar-live-content" class="rounded-lg bg-gray-50 dark:bg-gray-800 p-4">
			<p class="text-sm text-gray-600 dark:text-gray-400">
				Waiting for SSE stream...
			</p>
		</div>
	}
	@demoSection("Datastar Indicator", "datastar-indicator")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
		Shows/hides based on a Datastar indicator signal. Place
		<code>data-indicator:fetching</code> on any element that triggers a backend action:
	</p>
	<div class="flex items-center gap-3">
		<button
			data-on:click={ datastar.Post(demoURL("/api/datastar/action")) }
			data-indicator:fetching
			class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-blue-600 dark:bg-blue-500 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors motion-reduce:transition-none motion-reduce:duration-0"
		>
			Trigger Action
		</button>
		@datastar.Indicator(datastar.IndicatorProps{
			BaseProps: demoBaseProps(),
			Signal:    "fetching",
			Spinner:   feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM, Color: "text-blue-600 dark:text-blue-400"}),
		})
	</div>
	<div id="datastar-action-result" class="mt-3"></div>
	@demoSection("Datastar LoadingButton", "datastar-loading-button")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
		The label swaps to a busy state while the action is in flight, driven entirely by the
		<code>data-indicator:saving</code> signal — click and watch (the mock endpoint delays 1.5s):
	</p>
	<button
		data-on:click={ datastar.Post(demoURL("/api/datastar/slow-action")) }
		data-indicator:saving
		class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-blue-600 dark:bg-blue-500 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors motion-reduce:transition-none motion-reduce:duration-0"
	>
		@datastar.LoadingButton(datastar.LoadingButtonProps{
			BaseProps:   demoBaseProps(),
			Signal:      "saving",
			DefaultText: "Save changes",
			LoadingText: "Saving...",
		})
	</button>
	<div id="datastar-slow-action-result" class="mt-3"></div>
	@demoSection("Datastar PolledRegion", "datastar-polled-region")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
		Auto-refreshing region fetching <code>/api/datastar/tick</code> every 5s via
		<code>data-on-interval</code> — the Datastar twin of the HTMX PolledRegion. The region
		self-patches (response root id = region id), the timestamp ticks forward on every patch,
		and the demo settles after 3 ticks:
	</p>
	@datastarPolledStatsRegion(0)
	@demoSection("Datastar Action Expressions", "datastar-actions")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
		Typed helpers for building Datastar action expressions:
	</p>
	@demoCodeSnippet(
		"datastar actions",
		`datastar.Get("/api/search")       // @get('/api/search')
datastar.Post("/api/save")      // @post('/api/save')
datastar.Delete("/api/items/1") // @delete('/api/items/1')`,
	)
	@demoSection("Datastar SSE Error Handling", "datastar-sse-errors")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
		Global listener for Datastar stream failures (<code>datastar-fetch</code> events with
		type <code>error</code> or <code>retries-failed</code>) that surfaces them as accessible toasts —
		the Datastar counterpart to HTMX GlobalErrorHandling:
	</p>
	@datastar.SSEErrorHandling(datastar.SSEErrorHandlingConfig{Nonce: demoBaseProps().Nonce})
	@demoCodeSnippet("Go", `@feedback.ToastContainer("")
@datastar.SSEErrorHandling(datastar.DefaultSSEErrorHandlingConfig())`)
	@display.Card(display.CardProps{
		Title: "HTMX vs Datastar",
	}) {
		<p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
			Both work side-by-side. HTMX uses <code>hx-*</code> attributes for
			hypermedia exchanges. Datastar uses <code>data-*</code> attributes for
			SSE streaming and reactive signals.
		</p>
		<p class="text-sm text-gray-600 dark:text-gray-400">
			Use HTMX for request-response (forms, navigation, CRUD).
			Use Datastar for real-time push (dashboards, live feeds, collaborative editing).
		</p>
	}
}

// datastarPolledStatsRegion is the datastar.PolledRegion demo for both the
// initial render and the /api/datastar/tick response. The region self-patches
// (response fragment root id = region id), so the response re-renders the
// whole component to re-arm the interval — until the final tick, which
// renders the settled static shell without the interval attributes.
templ datastarPolledStatsRegion(tick int) {
	@datastar.PolledRegion(datastar.PolledRegionProps{
		BaseProps:     datastarPolledStatsBaseProps(),
		URL:           demoURL("/api/datastar/tick") + "?tick=" + strconv.Itoa(tick),
		Every:         "5s",
		ShowTimestamp: true,
		TimeFormat:    "15:04:05 MST",
		Now: func() time.Time {
			return time.Now().UTC()
		},
	}) {
		@datastarPolledStatsContent(tick, true)
	}
}

// datastarPolledStatsSettled is the final tick's fragment: the same region
// shell WITHOUT the interval attributes, so the runtime's outer patch
// replaces the polling region with static content and the demo settles.
templ datastarPolledStatsSettled(tick int) {
	{{ now := time.Now().UTC() }}
	<div id="datastar-polled-stats" role="region" aria-label="Live demo statistics" aria-live="polite">
		@datastarPolledStatsContent(tick, false)
		<div class="mt-3 flex justify-end">
			<time
				class="text-xs tabular-nums text-gray-500 dark:text-gray-400"
				datetime={ now.Format(time.RFC3339) }
			>
				Updated { now.Format("15:04:05") } UTC
			</time>
		</div>
	</div>
}

templ datastarPolledStatsContent(tick int, live bool) {
	<div class="rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-4 flex items-center gap-4">
		<div class="flex-1">
			<p class="text-sm font-medium text-gray-900 dark:text-white">Requests served: { fmt.Sprintf("%d", 48_210+tick*137) }</p>
		</div>
		if live {
			<span class="inline-flex items-center gap-1.5 text-xs text-blue-600 dark:text-blue-400">
				@feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM, Color: "text-blue-600 dark:text-blue-400"})
				auto-refreshing
			</span>
		} else {
			<span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-700 dark:text-emerald-400">up to date</span>
		}
	</div>
}
