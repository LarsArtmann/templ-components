package main

import (
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/utils"
)

templ feedbackDemo() {
	@demoSection("Alerts", "feedback-alerts")
	<div class="space-y-4">
		@feedback.Alert(feedback.AlertProps{Title: "Success", Message: "Operation completed.", Type: feedback.FeedbackSuccess})
		@feedback.Alert(feedback.AlertProps{Title: "Error", Message: "Something went wrong.", Type: feedback.FeedbackError})
		@feedback.Alert(feedback.AlertProps{Title: "Warning", Message: "Check your input.", Type: feedback.FeedbackWarning})
		@feedback.Alert(feedback.AlertProps{Title: "Info", Message: "Here is some information.", Type: feedback.FeedbackInfo})
	</div>
	@demoCodeSnippet("Go", `feedback.Alert(feedback.AlertProps{Title: "Saved", Message: "Changes saved.", Type: feedback.FeedbackSuccess})`)
	@demoSection("Toast (auto-generated ID, auto-dismiss)", "feedback-toast")
	<div class="space-y-3">
		<p class="text-sm text-gray-500 dark:text-gray-400">Toasts render into ToastContainer. Each auto-dismisses after 5s.</p>
		@feedback.Toast(feedback.ToastProps{Message: "Settings saved!", Type: feedback.FeedbackSuccess, Duration: 5000, BaseProps: utils.BaseProps{Nonce: demoNonceConst}})
		@feedback.Toast(feedback.ToastProps{Message: "Upload failed.", Type: feedback.FeedbackError, Title: "Error", BaseProps: utils.BaseProps{Nonce: demoNonceConst}})
		@feedback.Toast(feedback.ToastProps{Message: "Storage almost full.", Type: feedback.FeedbackWarning, BaseProps: utils.BaseProps{Nonce: demoNonceConst}})
		@feedback.Toast(feedback.ToastProps{Message: "New version available.", Type: feedback.FeedbackInfo, BaseProps: utils.BaseProps{Nonce: demoNonceConst}})
	</div>
	@demoCodeSnippet("Go", `feedback.Toast(feedback.ToastProps{Message: "Saved!", Type: feedback.FeedbackSuccess, Duration: 5000})`)
	@demoSection("Inline Feedback", "feedback-inline")
	<div class="space-y-2">
		@feedback.InlineError("Email is required")
		@feedback.InlineSuccess("Username is available")
		@feedback.InlineLoading("Saving...")
	</div>
	@demoSection("Spinners", "feedback-spinners")
	<div class="flex items-center gap-8">
		@feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM, Color: "text-blue-600 dark:text-blue-400"})
		@feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerMD, Color: "text-gray-600 dark:text-gray-400"})
		@feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerLG, Color: "text-red-600 dark:text-red-400"})
	</div>
	@demoSection("Progress Bars", "feedback-progress")
	<div class="space-y-4 max-w-md">
		@feedback.ProgressBar(feedback.ProgressBarProps{Current: 45, Total: 100, Label: "Uploading...", ShowLabel: true})
		@feedback.ProgressBar(feedback.ProgressBarProps{Current: 100, Total: 100, Label: "Complete", ShowLabel: true, Color: "bg-emerald-600 dark:bg-emerald-500"})
		@feedback.ProgressBar(feedback.ProgressBarProps{Indeterminate: true, Label: "Processing..."})
	</div>
	@demoSection("CircularProgress", "feedback-circular-progress")
	<div class="flex items-end gap-8">
		<div class="text-center space-y-2">
			@feedback.CircularProgress(feedback.CircularProgressProps{Value: 72, ShowLabel: true})
			<p class="text-xs text-gray-500 dark:text-gray-400">md + label</p>
		</div>
		<div class="text-center space-y-2">
			@feedback.CircularProgress(feedback.CircularProgressProps{Value: 45, Size: feedback.CircularProgressSizeSM})
			<p class="text-xs text-gray-500 dark:text-gray-400">sm</p>
		</div>
		<div class="text-center space-y-2">
			@feedback.CircularProgress(feedback.CircularProgressProps{Value: 100, Size: feedback.CircularProgressSizeLG, Color: "text-emerald-600 dark:text-emerald-500"})
			<p class="text-xs text-gray-500 dark:text-gray-400">lg + custom color</p>
		</div>
	</div>
	@demoSection("LoadingOverlay", "feedback-loading-overlay")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
		Static loading region for page transitions — announced politely, page stays reachable — pinned to this frame for the demo via a <code>Class</code> override:
	</p>
	<div class="relative h-56 overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
		@feedback.LoadingOverlay(feedback.LoadingOverlayProps{
			BaseProps:    utils.BaseProps{Class: "absolute"},
			Message:      "Loading workspace...",
			ShowProgress: true,
			Progress:     62,
		})
	</div>
	@demoSection("LoadingDialog", "feedback-loading-dialog")
	<p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
		Modal twin for genuinely blocking operations — native <code>&lt;dialog&gt;</code>: focus trap, inert page, Escape or backdrop click dismisses:
	</p>
	<div>
		<button
			type="button"
			class="rounded-md bg-blue-600 dark:bg-blue-500 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 dark:hover:bg-blue-600 focus:outline-hidden focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:ring-offset-2 motion-reduce:transition-none"
			data-tc-overlay-trigger="demo-loading-dialog"
		>
			Show blocking save dialog
		</button>
		@display.LoadingDialog(display.LoadingDialogProps{
			ID:           "demo-loading-dialog",
			Title:        "Saving workspace",
			Message:      "Saving workspace...",
			ShowProgress: true,
			Progress:     40,
		})
	</div>
	@demoSection("Step Indicator", "feedback-step-indicator")
	<div class="space-y-6">
		@feedback.StepIndicator(feedback.StepIndicatorProps{
			Steps:       []string{"Details", "Review", "Confirm", "Done"},
			CurrentStep: 1,
			AriaLabel:   "Checkout progress",
		})
		@feedback.StepIndicator(feedback.StepIndicatorProps{
			Steps:       []string{"Step 1", "Step 2", "Step 3"},
			CurrentStep: 2,
			Orientation: feedback.StepVertical,
			AriaLabel:   "Vertical step example",
		})
	</div>
	@demoSection("Skeletons", "feedback-skeletons")
	<div class="space-y-4">
		<div class="flex gap-4">
			@feedback.Skeleton(feedback.SkeletonAvatar)
			<div class="space-y-2">
				@feedback.Skeleton(feedback.SkeletonTitle)
				@feedback.Skeleton(feedback.SkeletonText)
				@feedback.Skeleton(feedback.SkeletonTextShort)
			</div>
		</div>
		@feedback.SkeletonGroup([]feedback.SkeletonVariant{
			feedback.SkeletonTableRow,
			feedback.SkeletonTableRow,
			feedback.SkeletonTableRow,
		})
	</div>
	@demoSection("Skeleton Card Grid", "feedback-skeleton-grid")
	@feedback.SkeletonCardGrid(feedback.SkeletonCardGridProps{Count: 3})
}
