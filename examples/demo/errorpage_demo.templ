package main

import (
	"github.com/larsartmann/templ-components/errorpage"
	"github.com/larsartmann/templ-components/layout"
)

templ errorpageDemo() {
	@demoSection("Standalone error pages", "errorpage-standalone")
	<p class="text-sm text-gray-500 dark:text-gray-400">
		Full-page error views are served by their own routes — the way consumers
		render them: one handler call per HTTP status, a real status code, the
		page inside the app's own layout shell.
	</p>
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
		@errorRouteCard("404 — Page not found", "/errors/404")
		@errorRouteCard("404 — Dedicated NotFound404", "/errors/404-page")
		@errorRouteCard("403 — Access denied", "/errors/403")
		@errorRouteCard("400 — Bad request", "/errors/400")
		@errorRouteCard("409 — Conflict", "/errors/409")
		@errorRouteCard("500 — Internal error", "/errors/500")
		@errorRouteCard("503 — Service unavailable", "/errors/503")
		@errorRouteCard("Full model — context, causes, trace", "/errors/full")
	</div>
	@demoSection("ErrorAlert (by family)", "errorpage-alerts")
	<div class="space-y-4">
		@errorpage.ErrorAlert(errorpage.ErrorAlertProps{Family: errorpage.FamilyRejection, Title: "Invalid Input", Message: "The email address format is invalid.", Fix: "Enter a valid email address."})
		@errorpage.ErrorAlert(errorpage.ErrorAlertProps{Family: errorpage.FamilyConflict, Title: "Version Conflict", Message: "Someone else modified this resource.", Fix: "Refresh and try again."})
		@errorpage.ErrorAlert(errorpage.ErrorAlertProps{Family: errorpage.FamilyTransient, Title: "Temporary Error", Message: "A temporary error occurred.", Fix: "Wait a moment and retry.", Dismissible: true})
		@errorpage.ErrorAlert(errorpage.ErrorAlertProps{Family: errorpage.FamilyCorruption, Title: "Data Corrupted", Message: "Configuration file is unreadable."})
		@errorpage.ErrorAlert(errorpage.ErrorAlertProps{Family: errorpage.FamilyInfrastructure, Title: "Service Unavailable", Message: "The service is currently down."})
		@errorpage.ErrorAlert(errorpage.ErrorAlertProps{Family: errorpage.FamilyOrchestration, Title: "Orchestration Failure", Message: "A workflow step failed unexpectedly."})
	</div>
	@demoSection("ErrorDetail (with context + cause chain)", "errorpage-details")
	<div class="space-y-4">
		@errorpage.ErrorDetail(errorpage.ErrorDetailProps{
			Family:  errorpage.FamilyCorruption,
			Code:    "data.parse_failed",
			Title:   "Parse Failed",
			Message: "config.yaml contains invalid syntax at line 42.",
			Fix:     "Check the YAML syntax.",
			Context: []errorpage.ContextPair{{Key: "file", Value: "config.yaml"}, {Key: "line", Value: "42"}},
		})
		@errorpage.ErrorDetail(errorpage.ErrorDetailProps{
			Family:     errorpage.FamilyTransient,
			Code:       "db.timeout",
			Title:      "Database Timeout",
			Message:    "Query took too long.",
			CauseChain: []errorpage.CauseItem{{Message: "connection pool exhausted", Code: "db.pool"}, {Message: "timeout after 30s", Code: "db.timeout"}},
		})
	</div>
}

templ errorRouteCard(title, href string) {
	<a
		href={ templ.SafeURL(href) }
		class="flex flex-col justify-between gap-2 rounded-lg border border-gray-200 p-4 transition-colors motion-reduce:transition-none hover:border-blue-300 hover:bg-blue-50 motion-reduce:hover:border-gray-200 motion-reduce:hover:bg-transparent dark:border-gray-700 dark:hover:border-blue-700 dark:hover:bg-blue-900/20"
	>
		<span class="font-medium text-gray-900 dark:text-white">{ title }</span>
		<span class="font-mono text-xs text-gray-500 dark:text-gray-400">{ href }</span>
	</a>
}

templ errorRoutePage(props layout.PageProps, content templ.Component) {
	@layout.Base(props) {
		@content
	}
}
