package display

import (
	"fmt"

	"github.com/larsartmann/templ-components/utils"
	"github.com/larsartmann/templ-components/utils/svg"
)

// carouselDotActiveClass and carouselDotIdleClass paint the visual dot inside
// a 24×24 hit-box button (WCAG 2.2 target size, M21/F097): the dot stays 8px
// while the BUTTON carries the target. Mirrored verbatim in the carousel JS
// (activeDot/idleDot) — keep the three sites in sync.
const (
	carouselDotActiveClass = "h-2 w-2 rounded-full bg-blue-600 dark:bg-blue-500"
	carouselDotIdleClass   = "h-2 w-2 rounded-full bg-gray-400/60 dark:bg-gray-500/60"
)

// CarouselSlide represents a single slide in a carousel.
type CarouselSlide struct {
	Content templ.Component
}

// CarouselProps configures a content carousel with prev/next navigation.
// Uses CSS scroll-snap for native touch/drag support and smooth scrolling.
type CarouselProps struct {
	utils.BaseProps
	Slides         []CarouselSlide
	ShowIndicators bool
	ShowArrows     bool
}

// DefaultCarouselProps returns sensible defaults.
func DefaultCarouselProps() CarouselProps {
	return CarouselProps{
		ShowArrows: true,
	}
}

// Carousel renders a slide carousel with native CSS scroll-snap for
// touch-friendly swiping, momentum scrolling, and smooth programmatic
// navigation. Prev/next buttons use scrollBy; dots sync via scrollend.
//
//	@display.Carousel(display.CarouselProps{
//	   Slides: []display.CararouselSlide{
//	     {Content: templ.Raw("<div>Slide 1</div>")},
//	     {Content: templ.Raw("<div>Slide 2</div>")},
//	   },
//	   ShowIndicators: true,
//	})
templ Carousel(props CarouselProps) {
	{{ id := utils.EnsureID("carousel", props.ID) }}
	<div
		id={ id }
		class={ utils.Class("relative rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-900", props.Class) }
		data-tc-carousel={ id }
		role="region"
		aria-roledescription="carousel"
		aria-label={ utils.Ternary(props.AriaLabel != "", props.AriaLabel, "Carousel") }
		tabindex="0"
		{ props.Attrs... }
	>
		<div
			class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-none"
			data-tc-carousel-track
			role="group"
			tabindex="0"
			aria-label="Slides"
		>
			for i, slide := range props.Slides {
				<div
					class="w-full flex-shrink-0 snap-center"
					role="group"
					aria-roledescription="slide"
					aria-label={ fmt.Sprintf("Slide %d of %d", i+1, len(props.Slides)) }
				>
					if slide.Content != nil {
						@slide.Content
					}
				</div>
			}
		</div>
		if props.ShowArrows && len(props.Slides) > 1 {
			<button
				type="button"
				class="absolute inset-s-0 top-1/2 -translate-y-1/2 p-2 rounded-full bg-white/80 dark:bg-gray-800/80 text-gray-700 dark:text-gray-300 hover:bg-white dark:hover:bg-gray-800 shadow-sm"
				data-tc-carousel-prev
				aria-label="Previous slide"
			>
				<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d={ svg.PathArrowLeft }></path>
				</svg>
			</button>
			<button
				type="button"
				class="absolute inset-e-0 top-1/2 -translate-y-1/2 p-2 rounded-full bg-white/80 dark:bg-gray-800/80 text-gray-700 dark:text-gray-300 hover:bg-white dark:hover:bg-gray-800 shadow-sm"
				data-tc-carousel-next
				aria-label="Next slide"
			>
				<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d={ svg.PathArrowRight }></path>
				</svg>
			</button>
		}
		if props.ShowIndicators && len(props.Slides) > 1 {
			<div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5">
				for i := range props.Slides {
					<button
						type="button"
						class="flex h-6 w-6 items-center justify-center rounded-full transition-colors motion-reduce:transition-none"
						data-tc-carousel-dot={ fmt.Sprintf("%d", i) }
						aria-label={ fmt.Sprintf("Go to slide %d", i+1) }
					>
						<span class={ utils.Ternary(i == 0, carouselDotActiveClass, carouselDotIdleClass) }></span>
					</button>
				}
			</div>
		}
		if props.Nonce != "" {
		@utils.ScriptComponent(props.Nonce, carouselJS, "carousel script")
		}
	</div>
}
