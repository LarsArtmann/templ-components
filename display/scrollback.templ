package display

import "github.com/larsartmann/templ-components/utils"

// ScrollbackTone colors a scrollback line's tag column.
type ScrollbackTone string

const (
	ScrollbackToneNeutral ScrollbackTone = "neutral"
	ScrollbackToneInfo    ScrollbackTone = "info"
	ScrollbackToneSuccess ScrollbackTone = "success"
	ScrollbackToneWarning ScrollbackTone = "warning"
	ScrollbackToneDanger  ScrollbackTone = "danger"
)

// ScrollbackToneIsValid reports whether tone is a known scrollback tone.
func ScrollbackToneIsValid(tone ScrollbackTone) bool {
	_, ok := scrollbackToneLookup[tone]
	return ok
}

// ScrollbackLine is one entry in a Scrollback. Timestamp is preformatted by
// the caller (e.g. "12:47:03.184"); Tag is a short column label (e.g.
// "query", "match"); Text is the line body.
type ScrollbackLine struct {
	Timestamp string
	Tag       string
	Text      string
	Tone      ScrollbackTone
}

// ScrollbackProps configures a terminal-style log block.
type ScrollbackProps struct {
	utils.BaseProps
	// Lines renders top-down in the given order. Empty slice renders nothing.
	Lines []ScrollbackLine
	// Stagger animates lines in sequentially (pure CSS, reduced-motion safe).
	// DefaultScrollbackProps enables it; the zero value renders instantly.
	Stagger bool
}

// DefaultScrollbackProps returns sensible defaults.
func DefaultScrollbackProps() ScrollbackProps {
	return ScrollbackProps{
		Stagger: true,
	}
}

// Scrollback renders a server-rendered, terminal-style log block: monospace
// lines with a timestamp column and a tone-colored tag column. With Stagger
// enabled, lines fade in sequentially via CSS nth-child delays — zero
// JavaScript, and prefers-reduced-motion users see all lines immediately.
//
// The block is decorative by default (aria-hidden). Pass AriaLabel when the
// lines carry real information screen readers should read.
//
//	@display.Scrollback(display.ScrollbackProps{
//	   Stagger: true,
//	   Lines: []display.ScrollbackLine{
//	       {Timestamp: "12:47:03.184", Tag: "query", Text: "ads.example.com A", Tone: display.ScrollbackToneInfo},
//	       {Timestamp: "12:47:03.185", Tag: "action", Text: "NXDOMAIN", Tone: display.ScrollbackToneDanger},
//	   },
//	})
templ Scrollback(props ScrollbackProps) {
	if len(props.Lines) > 0 {
		<div
			if props.ID != "" {
				id={ props.ID }
			}
			class={ utils.Class("tc-log text-start border-y border-gray-200 py-3 font-mono text-[0.8125rem] leading-relaxed text-gray-600 dark:border-gray-700 dark:text-gray-400", props.Class) }
			if props.AriaLabel == "" {
				aria-hidden="true"
			}
			if props.AriaLabel != "" {
				aria-label={ props.AriaLabel }
			}
			{ props.Attrs... }
		>
			for _, line := range props.Lines {
				<div class={ utils.Ternary(props.Stagger, "tc-log-line", "tc-log-line tc-log-line-still") }>
					if line.Timestamp != "" {
						<span class="me-3 text-gray-400 dark:text-gray-500">{ line.Timestamp }</span>
					}
					if line.Tag != "" {
						<span class={ utils.Class("me-2 inline-block min-w-12 font-medium", scrollbackToneClass(line.Tone)) }>{ line.Tag }</span>
					}
					{ line.Text }
				</div>
			}
		</div>
	}
}

// Lookup maps live in this .templ file (not a separate .go file) so
// Tailwind's content scanner detects the class strings.

//nolint:gochecknoglobals // Package-level lookup table for scrollback tones
var scrollbackToneLookup = map[ScrollbackTone]string{
	ScrollbackToneNeutral: "text-gray-500 dark:text-gray-400",
	ScrollbackToneInfo:    "text-blue-600 dark:text-blue-400",
	ScrollbackToneSuccess: "text-green-600 dark:text-green-400",
	ScrollbackToneWarning: "text-amber-600 dark:text-amber-400",
	ScrollbackToneDanger:  "text-red-600 dark:text-red-400",
}

// scrollbackToneClass maps a tone to its tag color classes, falling back to
// neutral for unknown values.
func scrollbackToneClass(tone ScrollbackTone) string {
	return utils.Lookup(scrollbackToneLookup, tone, scrollbackToneLookup[ScrollbackToneNeutral])
}
