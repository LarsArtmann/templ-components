package display

import "fmt"

// chartAxes renders the Y-axis ticks, optional gridlines, axis lines, and
// X-axis labels. Shared between LineChart and AreaChart.
templ chartAxes(d ChartRenderData) {
	for _, tick := range d.Ticks {
		{{ y := float64(d.Padding.Top) + float64(d.PlotH) - ((tick-d.MinVal)/d.RangeVal)*float64(d.PlotH) }}
		if d.ShowGrid {
			<line
				x1={ d.Padding.Left }
				y1={ y }
				x2={ d.Width - d.Padding.Right }
				y2={ y }
				class="stroke-gray-200 dark:stroke-gray-700"
				stroke-width="1"
				stroke-dasharray="4 4"
			></line>
		}
		<text
			x={ d.Padding.Left - lineChartTickLen }
			y={ y + lineChartLabelYOffset }
			text-anchor="end"
			class="fill-gray-500 dark:fill-gray-400"
			font-size={ lineChartFontSize }
		>{ lineChartTickFormat(d.ValueFormat, tick) }</text>
	}
	<line
		x1={ d.Padding.Left }
		y1={ d.Padding.Top }
		x2={ d.Padding.Left }
		y2={ d.Padding.Top + d.PlotH }
		class="stroke-gray-300 dark:stroke-gray-600"
		stroke-width="1"
	></line>
	<line
		x1={ d.Padding.Left }
		y1={ d.Padding.Top + d.PlotH }
		x2={ d.Width - d.Padding.Right }
		y2={ d.Padding.Top + d.PlotH }
		class="stroke-gray-300 dark:stroke-gray-600"
		stroke-width="1"
	></line>
	if d.LabelCount > 0 {
		for i := range d.LabelCount {
			if i < len(d.XAxisLabels) {
				{{
					// Boundary labels anchor inward so they never cross the
					// axis lines: a middle-anchored first label collides with
					// the y-axis tick text, a middle-anchored last label
					// overflows the right edge.
					anchor := "middle"
					x := d.Padding.Left + int(lineChartTickLabelX(d.PlotW, d.LabelCount, i))
					switch i {
					case 0:
						anchor = "start"
						x = d.Padding.Left
					case d.LabelCount - 1:
						anchor = "end"
						x = d.Padding.Left + d.PlotW
					}
				}}
				<text
					x={ x }
					y={ d.Padding.Top + d.PlotH + lineChartXLabelOffset }
					text-anchor={ anchor }
					class="fill-gray-500 dark:fill-gray-400"
					font-size={ lineChartFontSize }
				>{ d.XAxisLabels[i] }</text>
			}
		}
	}
}

// chartLegend renders the color-swatch legend above the chart. Shared between
// LineChart and AreaChart.
templ chartLegend(d ChartRenderData) {
	if len(d.LegendItems) > 0 {
		for _, li := range d.LegendItems {
			<g transform={ fmt.Sprintf("translate(%d,%d)", li.X, lineChartLegendY) }>
				<rect
					width="14"
					height="3"
					y="-2"
					rx="1"
					class={ li.Color }
					fill="currentColor"
				></rect>
				<text
					x="18"
					y="2"
					class="fill-gray-600 dark:fill-gray-300"
					font-size={ lineChartFontSize }
				>{ li.Name }</text>
			</g>
		}
	}
}

// chartEmptyStateMsg renders the "No data" message centered in the SVG canvas.
// Shared between LineChart and AreaChart.
templ chartEmptyStateMsg(d ChartRenderData) {
	<text
		x={ d.Width / 2 }
		y={ d.Height / 2 }
		text-anchor="middle"
		dominant-baseline="middle"
		class="fill-gray-400 dark:fill-gray-500"
		font-size={ lineChartEmptyFontSize }
	>{ d.EmptyMsg }</text>
}

// chartSeriesRenderOpts carries the per-chart series rendering switches.
type chartSeriesRenderOpts struct {
	// filled renders the semi-transparent area fill under the line (AreaChart).
	filled bool
	// fillOpacity is the area fill opacity string; only used when filled.
	fillOpacity string
	// showDots renders a circle at every projected point.
	showDots bool
}

// chartSeriesGroup renders one series as an SVG group: optional area fill,
// the stroked line (smooth or linear), and optional dots. Shared by LineChart
// and AreaChart so stroke, dash, and dot rendering stay in lockstep.
templ chartSeriesGroup(d ChartRenderData, series LineChartSeries, i int, style LineChartStyle, opts chartSeriesRenderOpts) {
	{{
		color := lineChartColor(i, series.Color)
		strokeW := lineChartStrokeWidth(series.StrokeWidth)
		pts := ScalePoints(series.Values, d.PlotW, d.PlotH, d.MinVal, d.MaxVal)

		var linePath string
		if style == LineChartStyleSmooth {
			linePath = BuildSmoothPath(pts)
		} else {
			linePath = BuildPolylinePath(pts)
		}
	}}
	<g
		class={ color }
		transform={ fmt.Sprintf("translate(%d,%d)", d.Padding.Left, d.Padding.Top) }
	>
		if opts.filled {
			<path
				d={ BuildAreaPath(pts, d.PlotH) }
				fill="currentColor"
				fill-opacity={ opts.fillOpacity }
				stroke="none"
			></path>
		}
		<path
			d={ linePath }
			fill="none"
			stroke="currentColor"
			stroke-width={ fmt.Sprintf("%g", strokeW) }
			stroke-linecap="round"
			stroke-linejoin="round"
			if series.Dashed {
				stroke-dasharray="5 5"
			}
		></path>
		if opts.showDots {
			for _, p := range pts {
				<circle cx={ p.X } cy={ p.Y } r={ lineChartDotRadius } fill="currentColor"></circle>
			}
		}
	</g>
}
