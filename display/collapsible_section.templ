package display

import (
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/utils"
)

// CollapsibleSection wraps content in a native <details>/<summary> pair so
// users can collapse detail-heavy regions. The section renders open by
// default. When StorageKey is set, the open/closed state can be persisted
// to localStorage by a consumer-side script reading the data-collapsible
// attribute.
//
//	@display.CollapsibleSection(display.CollapsibleSectionProps{
//	   Title: "Advanced Filters",
//	   StorageKey: "advanced-filters",
//	}) {
//	   <p>Collapsible content here.</p>
//	}
templ CollapsibleSection(props CollapsibleSectionProps) {
	{{
		p := resolveCollapsibleDefaults(props)
		tag := p.TitleTag
		if !isValidHeadingTag(tag) {
			tag = "h3"
		}
	}}
	<details
		class={ utils.Class("group rounded-lg", p.Class) }
		if p.StorageKey != "" { data-collapsible={ p.StorageKey } }
		if p.ID != "" { id={ p.ID } }
		if !p.Collapsed { open }
		{ p.Attrs... }
	>
		<summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-1 py-1 text-gray-900 outline-none focus-visible:ring-2 focus-visible:ring-[var(--ds-brand)] hover:bg-gray-50 dark:text-white dark:hover:bg-gray-800 [&::-webkit-details-marker]:hidden">
			if tag == "h1" {
				<h1 class="text-lg font-semibold">{ p.Title }</h1>
			} else if tag == "h2" {
				<h2 class="text-lg font-semibold">{ p.Title }</h2>
			} else if tag == "h4" {
				<h4 class="text-lg font-semibold">{ p.Title }</h4>
			} else if tag == "h5" {
				<h5 class="text-lg font-semibold">{ p.Title }</h5>
			} else if tag == "h6" {
				<h6 class="text-lg font-semibold">{ p.Title }</h6>
			} else {
				<h3 class="text-lg font-semibold">{ p.Title }</h3>
			}
			@icons.Icon(p.Icon, "h-5 w-5 shrink-0 text-gray-400 dark:text-gray-500 transition-transform duration-200 motion-reduce:transition-none motion-reduce:duration-200 group-open:rotate-180")
		</summary>
		<div class="mt-4">
			{ children... }
		</div>
	</details>
}
