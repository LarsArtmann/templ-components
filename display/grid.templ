package display

import "github.com/larsartmann/templ-components/utils"

// GridCols is a typed enum for the responsive column count of a Grid. Unknown
// values fall back to GridCols3 (graceful degradation — never panic).
type GridCols string

const (
	GridCols1 GridCols = "1"
	GridCols2 GridCols = "2"
	GridCols3 GridCols = "3"
	GridCols4 GridCols = "4"
	GridCols5 GridCols = "5"
	GridCols6 GridCols = "6"
	// GridColsAutoFit uses CSS auto-fit + minmax() instead of fixed breakpoints.
	// The grid responds to container width, not viewport. Requires MinColWidth.
	GridColsAutoFit GridCols = "auto-fit"
	// GridColsDefault is the canonical default (3 columns at the lg breakpoint).
	GridColsDefault GridCols = GridCols3
)

// GridGap is a typed enum for the gap spacing between grid items.
// Unknown values fall back to GridGapMD (graceful degradation — never panic).
type GridGap string

const (
	GridGapSM GridGap = "sm" // gap-2 (0.5rem)
	GridGapMD GridGap = "md" // gap-4 (1rem) — default
	GridGapLG GridGap = "lg" // gap-6 (1.5rem)
	GridGapXL GridGap = "xl" // gap-8 (2rem)
	// GridGapDefault is the canonical default.
	GridGapDefault GridGap = GridGapMD
)

// gridGapLookup maps each GridGap value to its Tailwind gap utility class.
var gridGapLookup = map[GridGap]string{
	GridGapSM: "gap-2",
	GridGapMD: "gap-4",
	GridGapLG: "gap-6",
	GridGapXL: "gap-8",
}

func gridGapClass(gap GridGap) string {
	return utils.Lookup(gridGapLookup, gap, gridGapLookup[GridGapDefault])
}

// gridColsLookup maps each GridCols value to the responsive Tailwind classes
// that stack on mobile and expand at sm/lg breakpoints. This is a pure class
// lookup, so the map+fallback pattern applies.
var gridColsLookup = map[GridCols]string{
	GridCols1: "grid grid-cols-1",
	GridCols2: "grid grid-cols-1 sm:grid-cols-2",
	GridCols3: "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
	GridCols4: "grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4",
	GridCols5: "grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5",
	GridCols6: "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6",
}

// gridColsContainerLookup maps each GridCols value to container-query-based
// Tailwind classes (@sm:, @lg:) that respond to the parent container's width
// instead of the browser viewport. Used when ContainerAware is true.
var gridColsContainerLookup = map[GridCols]string{
	GridCols1: "grid grid-cols-1",
	GridCols2: "grid grid-cols-1 @sm:grid-cols-2",
	GridCols3: "grid grid-cols-1 @sm:grid-cols-2 @lg:grid-cols-3",
	GridCols4: "grid grid-cols-1 @sm:grid-cols-2 @md:grid-cols-3 @lg:grid-cols-4",
	GridCols5: "grid grid-cols-1 @sm:grid-cols-2 @md:grid-cols-3 @lg:grid-cols-4 @xl:grid-cols-5",
	GridCols6: "grid grid-cols-1 @sm:grid-cols-2 @lg:grid-cols-3 @xl:grid-cols-6",
}

// gridClass returns the responsive Tailwind class string for a column count,
// falling back to GridColsDefault for unknown values.
func gridClass(cols GridCols) string {
	return utils.Lookup(gridColsLookup, cols, gridColsLookup[GridColsDefault])
}

// gridAutoFitClass returns the auto-fit/minmax template class. The minimum
// column width is NOT concatenated into the class: a runtime-composed
// arbitrary value is invisible to Tailwind's source scanner, so the utility
// is never generated and every auto-fit grid silently collapses to a single
// column. The class stays a complete literal and reads the width from the
// --tc-grid-min custom property that gridAutoFitStyle sets.
func gridAutoFitClass() string {
	return "grid [grid-template-columns:repeat(auto-fit,minmax(var(--tc-grid-min),1fr))]"
}

// gridAutoFitStyle returns the inline custom-property declaration carrying the
// minimum column width for an auto-fit grid, defaulting to 240px. It is the
// runtime half of gridAutoFitClass (documented inline-style exemption, same
// shape as the chart and heatmap width/height properties).
func gridAutoFitStyle(minColWidth string) string {
	if minColWidth == "" {
		minColWidth = "240px"
	}

	return "--tc-grid-min:" + minColWidth
}

// gridContainerClass returns the container-query-based Tailwind class string
// for a column count, falling back to GridColsDefault for unknown values.
func gridContainerClass(cols GridCols) string {
	return utils.Lookup(gridColsContainerLookup, cols, gridColsContainerLookup[GridColsDefault])
}

// GridProps configures a responsive grid layout. Use Grid to lay out cards,
// stat cards, or any repeating content with consistent responsive breakpoints
// without repeating the long `grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3`
// utility string on every page.
//
// Children require a templ render context: Grid receives its cells through
// the templ children slot, so rendering the component directly into a plain
// writer (`Component.Render(ctx, &buf)` from Go, outside a templ tree) emits
// the grid shell with EMPTY cells — valid HTML, silently missing content.
// Pass the items through a templ template (even a trivial one that ranges
// over a slice) so the children context exists. The same limitation applies
// to every children-carrying component in this library (Card's slots,
// Modal/Drawer content, Accordion items with nested markup, …).
type GridProps struct {
	utils.BaseProps
	// Cols controls the responsive column count. Defaults to GridCols3 when
	// empty or unknown.
	Cols GridCols
	// Gap controls the spacing between grid items. Defaults to GridGapMD (gap-4).
	Gap GridGap
	// ContainerAware, when true, renders the grid inside an @container
	// wrapper so column counts respond to the container's width instead of
	// the browser viewport. Opt-in: the struct-literal zero value is
	// viewport-based; DefaultGridProps() sets it true. Set it explicitly
	// (true or false) whenever a bare GridProps{...} literal is used.
	ContainerAware bool
	// MinColWidth sets the minimum column width for auto-fit grids. Used only
	// when Cols is GridColsAutoFit. Include units ("190px", "12rem"); empty
	// means 240px. The value travels as the --tc-grid-min custom property so
	// the emitted class stays a literal Tailwind can see — never hand-compose
	// an arbitrary class from a prop, the scanner will not generate it.
	// Ignored for fixed column counts. When Cols is GridColsAutoFit,
	// ContainerAware is ignored (auto-fit already responds to container
	// width via CSS minmax).
	MinColWidth string
}

// DefaultGridProps returns sensible defaults (GridCols3).
func DefaultGridProps() GridProps {
	return GridProps{ //nolint:exhaustruct // intentionally minimal defaults
		Cols:           GridColsDefault,
		ContainerAware: true,
	}
}

// Grid renders a responsive grid container that stacks on mobile and expands
// at sm/lg breakpoints. Pass grid items as children.
//
//	@display.Grid(display.GridProps{Cols: display.GridCols3}) {
//	   for _, u := range users {
//	     @display.Card(display.CardProps{Title: u.Name}) { <p>{ u.Email }</p> }
//	   }
//	}
//
// For container-query-based responsiveness (grid adapts to its parent container,
// not the viewport):
//
//	@display.Grid(display.GridProps{Cols: display.GridCols3, ContainerAware: true}) {
//	   // items
//	}
//
// HYBRID RENDERING CAVEAT (strings.Builder path): Grid is a children-slot
// component. When a component is rendered OUTSIDE a templ file — e.g. a
// hybrid renderer calling component.Render(ctx, w) straight into a
// strings.Builder — the { children... } slot renders EMPTY: templ only
// captures children when the component is invoked from another templ
// template. Escape hatch: pass children programmatically via
// templ.WithChildren(ctx, child) before Render (pinned by
// TestGridHybridChildrenViaWithChildren). Details:
// docs/recipes/hybrid-strings-builder-rendering.md.
templ Grid(props GridProps) {
	{{
		cols := props.Cols
		if cols == "" {
			cols = GridColsDefault
		}
		gap := gridGapClass(props.Gap)
		baseGrid := gridClass(cols)
		gridStyle := ""
		if cols == GridColsAutoFit {
			baseGrid = gridAutoFitClass()
			gridStyle = gridAutoFitStyle(props.MinColWidth)
		} else if props.ContainerAware {
			baseGrid = gridContainerClass(cols)
		}
		gridClasses := utils.Class(baseGrid, gap, props.Class)
	}}
	if props.ContainerAware {
		<div class="@container">
			@gridInner(props, gridClasses, gridStyle) {
				{ children... }
			}
		</div>
	} else {
		@gridInner(props, gridClasses, gridStyle) {
			{ children... }
		}
	}
}

// gridInner renders the grid element itself, shared by the container-query and
// viewport layouts so the attribute contract (id, class, runtime style, aria
// label, consumer attrs, children) cannot drift between them.
templ gridInner(props GridProps, gridClasses, gridStyle string) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ gridClasses }
		if gridStyle != "" {
			style={ gridStyle }
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		{ props.Attrs... }
	>
		{ children... }
	</div>
}
