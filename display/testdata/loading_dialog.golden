<dialog id="demo-loading-dialog" class="bg-white dark:bg-gray-900 dark:shadow-black/20 max-w-sm mx-4 overflow-hidden print:hidden rounded-lg shadow-xl tc-modal tc-overlay w-full" aria-label="Saving workspace..." closedby="any"><div class="px-4 py-4 sm:px-6"><div class="py-6 text-center" aria-busy="true"><div class="bg-blue-100 dark:bg-blue-900/30 flex h-12 items-center justify-center mb-4 mx-auto rounded-full w-12"><svg class="animate-spin dark:text-blue-400 h-6 motion-reduce:animate-none text-blue-600 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle> <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></div><p class="dark:text-white font-medium mb-2 text-gray-900 text-lg">Saving workspace...</p><div class="bg-gray-200 dark:bg-gray-700 h-2 mb-2 rounded-full w-full"><div class="bg-blue-600 dark:bg-blue-500 duration-300 ease-out h-2 motion-reduce:duration-0 motion-reduce:transition-none rounded-full transition-all" style="width: 40%;"></div></div><p class="dark:text-gray-400 text-gray-500 text-sm">40%</p></div></div></dialog><script nonce="nonce123">
if(!window.tcOverlayModalAttached){window.tcOverlayModalAttached=true;window.tcOpenModal=function(id){var d=document.getElementById(id);if(d&&typeof d.showModal==='function')d.showModal();};window.tcCloseModal=function(id){var d=document.getElementById(id);if(d)d.close();};}if(!window.tcOverlayTriggerAttached){window.tcOverlayTriggerAttached=true;document.addEventListener('click',function(e){var b=e.target.closest('[data-tc-overlay-trigger]');if(!b)return;var d=document.getElementById(b.getAttribute('data-tc-overlay-trigger'));if(d&&!d.open&&typeof d.showModal==='function')d.showModal();});}(function(id){var d=document.getElementById(id);if(!d)return;if(d.hasAttribute('data-tc-open')&&!d.open)d.showModal();function tcOutside(e,dlg){var r=dlg.getBoundingClientRect();return e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom;}d.addEventListener('click',function(e){if(e.target.closest('[data-tc-close]'))d.close();});(function(dlg){var pressed=false;dlg.addEventListener('pointerdown',function(e){pressed=tcOutside(e,dlg);});dlg.addEventListener('pointerup',function(e){if(pressed&&tcOutside(e,dlg))dlg.close();});})(d);})("demo-loading-dialog");
</script>