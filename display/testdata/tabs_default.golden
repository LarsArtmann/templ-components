<div class="w-full"><div role="tablist" aria-label="Tabs" class="border-b border-gray-200 dark:border-gray-700"><div class="-mb-px flex space-x-8"><a id="overview-tab" href="#overview" role="tab" aria-selected="true" aria-controls="overview" tabindex="0" class="border-b-2 border-blue-500 dark:text-blue-400 font-medium px-1 py-4 text-blue-600 text-sm whitespace-nowrap">Overview</a><a id="activity-tab" href="#activity" role="tab" aria-selected="false" aria-controls="activity" tabindex="-1" class="border-b-2 border-transparent dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:border-gray-300 hover:text-gray-700 px-1 py-4 text-gray-500 text-sm whitespace-nowrap">Activity</a><a id="settings-tab" href="#settings" role="tab" aria-selected="false" aria-controls="settings" tabindex="-1" class="border-b-2 border-transparent dark:hover:border-gray-600 dark:hover:text-gray-200 dark:text-gray-400 font-medium hover:border-gray-300 hover:text-gray-700 px-1 py-4 text-gray-500 text-sm whitespace-nowrap">Settings</a></div></div><div id="overview" role="tabpanel" aria-labelledby="overview-tab" class="mt-4"><p>Overview content</p></div><div id="activity" role="tabpanel" aria-labelledby="activity-tab" hidden class="mt-4"><p>Activity feed</p></div><div id="settings" role="tabpanel" aria-labelledby="settings-tab" hidden class="mt-4"><p>Settings panel</p></div></div>