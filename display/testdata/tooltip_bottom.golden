<div id="tc-tooltip-NORMALIZED" data-tc-tooltip data-tc-position="bottom" class="group inline-flex relative" aria-describedby="tc-tooltip-NORMALIZED-tooltip"><div id="tc-tooltip-NORMALIZED-tooltip" class="-translate-x-1/2 absolute bg-gray-900 dark:bg-gray-700 font-medium group-focus-within:block group-hover:block hidden left-1/2 mt-2 px-2 py-1 rounded-md shadow-xs text-white text-xs top-full whitespace-nowrap z-20" role="tooltip">More details here<div class="-translate-x-1/2 absolute border-4 border-b-gray-900 border-transparent bottom-full dark:border-b-gray-700 h-0 left-1/2 w-0"></div></div></div><script>
if(!window.tcTooltipAriaAttached){window.tcTooltipAriaAttached=true;function tcTooltipAriaSync(){document.querySelectorAll("[data-tc-tooltip]").forEach(function(wrap){var desc=wrap.getAttribute("aria-describedby");if(!desc)return;var focusable=wrap.querySelector('button,a[href],input,select,textarea,[tabindex]:not([tabindex="-1"])');if(focusable&&!focusable.hasAttribute("aria-describedby")){focusable.setAttribute("aria-describedby",desc);}});}tcTooltipAriaSync();document.body.addEventListener("htmx:afterSettle",tcTooltipAriaSync);function tcTooltipWrap(e){if(!e||!e.target||!e.target.closest)return null;return e.target.closest("[data-tc-tooltip]");}function tcTooltipClamp(wrap){var bubble=wrap.querySelector("[role=tooltip]");if(!bubble)return;bubble.style.marginLeft="";var r=bubble.getBoundingClientRect();if(r.width===0)return;var vw=document.documentElement.clientWidth;var gap=8;var shift=0;if(r.left<gap)shift=gap-r.left;else if(r.right>vw-gap)shift=(vw-gap)-r.right;if(shift)bubble.style.marginLeft=shift+"px";}function tcTooltipShow(e){var wrap=tcTooltipWrap(e);if(!wrap)return;wrap.removeAttribute("data-tc-tooltip-dismissed");requestAnimationFrame(function(){tcTooltipClamp(wrap);requestAnimationFrame(function(){tcTooltipClamp(wrap);});});}document.addEventListener("keydown",function(e){if(e.key!=="Escape")return;var wrap=tcTooltipWrap(e);if(!wrap)return;wrap.setAttribute("data-tc-tooltip-dismissed","true");});document.addEventListener("mouseenter",function(e){if(!e||!e.target||!e.target.closest)return;if(e.target.closest("[data-tc-tooltip]"))tcTooltipShow(e);},true);document.addEventListener("focusin",function(e){tcTooltipShow(e);});}
</script>