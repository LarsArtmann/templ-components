package htmx

import (
	"time"

	"github.com/larsartmann/templ-components/utils"
)

// polledLiveValue returns the aria-live value, defaulting to polite.
func polledLiveValue(live PolledLive) PolledLive {
	if PolledLiveIsValid(live) {
		return live
	}
	return PolledLivePolite
}

// polledSwapValue returns the swap style, defaulting to outerHTML.
func polledSwapValue(swap SwapStyle) SwapStyle {
	if validSwapStyles[swap] {
		return swap
	}
	return SwapOuterHTML
}

// PolledRegion renders a div that auto-refreshes its content via HTMX polling
// on an interval. The region replaces itself (hx-swap="outerHTML") on each
// poll, which means the children re-render server-side on every request.
//
// Include a "Updated HH:MM:SS" timestamp (ShowTimestamp: true) so operators
// can verify polling is active — if the timestamp freezes, polling has stalled.
//
// When Eager fires the first fetch on load, the region renders with an
// aria-busy="true" busy cue (data-tc-polled-busy marker) that a singleton
// script clears on the first completed request (htmx:afterRequest fires for
// success AND error completions) — parity with datastar.LiveRegion's busy
// cue, so screen readers wait for the fresh content instead of announcing
// the stale initial render twice.
//
//	@htmx.PolledRegion(htmx.PolledRegionProps{URL: "/partials/stats", Every: "10s", Eager: true}) {
//	   @display.StatCard(display.StatCardProps{Label: "Messages", Value: "1,234"})
//	}
templ PolledRegion(props PolledRegionProps) {
	{{
		live := polledLiveValue(props.Live)
		swap := polledSwapValue(props.Swap)
		trigger := props.Trigger
		if trigger == "" {
			trigger = "every " + props.Every
			if props.Eager {
				trigger = "load, every " + props.Every
			}
		}
		eager := props.Eager && props.Trigger == ""
		updatedAt := time.Now()
		timeFormat := props.TimeFormat
		if timeFormat == "" {
			timeFormat = "15:04:05"
		}
	}}
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		hx-get={ templ.SafeURL(props.URL) }
		hx-trigger={ trigger }
		hx-swap={ string(swap) }
		aria-live={ string(live) }
		if eager {
			aria-busy="true"
			data-tc-polled-busy
		}
		class={ utils.Class("", props.Class) }
		{ props.Attrs... }
	>
		{ children... }
		if props.ShowTimestamp {
			<div class="mt-3 flex justify-end">
				<time
					class="text-xs tabular-nums text-gray-400 dark:text-gray-500"
					datetime={ updatedAt.Format(time.RFC3339) }
				>
					Updated { updatedAt.Format(timeFormat) }
				</time>
			</div>
		}
	</div>
	if eager {
		@polledRegionBusyScript(props.Nonce)
	}
}

// polledRegionBusyScript clears the aria-busy loading cue once the region's
// first poll completes (htmx:afterRequest fires after every request
// completion — success or error — so a failing endpoint also un-busies the
// region and leaves the initial content readable). Singleton-guarded: safe
// across HTMX re-renders and multiple regions on one page.
templ polledRegionBusyScript(nonce string) {
	<script { polledRegionBusyScriptAttrs(nonce)... }>
		(function() {
			'use strict';
			if (window.tcPolledBusyAttached) return;
			window.tcPolledBusyAttached = true;
			document.addEventListener('htmx:afterRequest', function(evt) {
				var el = (evt.detail && evt.detail.elt) || evt.target;
				if (el && el.hasAttribute && el.hasAttribute('data-tc-polled-busy')) {
					el.removeAttribute('aria-busy');
					el.removeAttribute('data-tc-polled-busy');
				}
			});
		})();
	</script>
}
