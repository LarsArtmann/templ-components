<div id="tc-loading-indicator" class="backdrop-blur-xs bg-white/80 dark:bg-gray-950/80 duration-200 fixed flex htmx-indicator inset-0 items-center justify-center motion-reduce:duration-0 motion-reduce:transition-none opacity-0 pointer-events-none transition-opacity z-50" role="status" aria-live="polite"><span class="sr-only">Loading…</span><div class="flex flex-col gap-3 items-center"><svg class="animate-spin dark:text-blue-400 h-5 text-blue-600 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"></svg></div></div>