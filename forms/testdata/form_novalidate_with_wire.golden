<script>
if(!window.tcValidityAttached){window.tcValidityAttached=true;function tcSyncValidity(t){if(!t||!t.matches||!t.matches('input,textarea,select'))return;if(t.matches(':user-invalid')){if(t.getAttribute('aria-invalid')!=='true'){t.setAttribute('data-tc-user-invalid','');t.setAttribute('aria-invalid','true');}}else if(t.hasAttribute('data-tc-user-invalid')){t.removeAttribute('data-tc-user-invalid');t.removeAttribute('aria-invalid');}}document.addEventListener('blur',function(e){tcSyncValidity(e.target);},true);document.addEventListener('focus',function(e){tcSyncValidity(e.target);},true);document.addEventListener('input',function(e){tcSyncValidity(e.target);});}</script>
<form action="/submit" method="POST" novalidate class="space-y-6" data-on:submit="@post(&#39;/api/submit&#39;, {contentType: &#39;form&#39;})"></form>