<fieldset class=""><legend class="block dark:text-white font-medium leading-6 text-gray-900 text-sm">Size </legend><div class="flex mt-2 space-x-6"><div class="flex items-center"><input type="radio" name="size" value="sm" class="border-gray-300 dark:bg-gray-800 dark:border-gray-600 dark:checked:bg-blue-600 dark:focus:ring-blue-500 dark:text-blue-400 focus:ring-blue-600 h-4 text-blue-600 w-4"> <label class="dark:text-white font-medium ms-3 text-gray-900 text-sm">Small</label></div><div class="flex items-center"><input type="radio" name="size" value="md" class="border-gray-300 dark:bg-gray-800 dark:border-gray-600 dark:checked:bg-blue-600 dark:focus:ring-blue-500 dark:text-blue-400 focus:ring-blue-600 h-4 text-blue-600 w-4" checked> <label class="dark:text-white font-medium ms-3 text-gray-900 text-sm">Medium</label></div><div class="flex items-center"><input type="radio" name="size" value="lg" class="border-gray-300 dark:bg-gray-800 dark:border-gray-600 dark:checked:bg-blue-600 dark:focus:ring-blue-500 dark:text-blue-400 focus:ring-blue-600 h-4 text-blue-600 w-4"> <label class="dark:text-white font-medium ms-3 text-gray-900 text-sm">Large</label></div></div></fieldset>