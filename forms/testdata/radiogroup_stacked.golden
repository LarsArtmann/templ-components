<fieldset class=""><legend class="block dark:text-white font-medium leading-6 text-gray-900 text-sm">Select a plan </legend><div class="mt-2 space-y-2"><div class="flex items-center"><input type="radio" name="plan" value="free" id="plan-free" class="border-gray-300 dark:bg-gray-800 dark:border-gray-600 dark:checked:bg-blue-600 dark:focus:ring-blue-500 dark:text-blue-400 focus:ring-blue-600 h-4 text-blue-600 w-4"> <label for="plan-free" class="dark:text-white font-medium ms-3 text-gray-900 text-sm">Free tier</label></div><div class="flex items-center"><input type="radio" name="plan" value="pro" id="plan-pro" class="border-gray-300 dark:bg-gray-800 dark:border-gray-600 dark:checked:bg-blue-600 dark:focus:ring-blue-500 dark:text-blue-400 focus:ring-blue-600 h-4 text-blue-600 w-4" checked> <label for="plan-pro" class="dark:text-white font-medium ms-3 text-gray-900 text-sm">Pro tier</label></div><div class="flex items-center"><input type="radio" name="plan" value="enterprise" id="plan-enterprise" class="border-gray-300 dark:bg-gray-800 dark:border-gray-600 dark:checked:bg-blue-600 dark:focus:ring-blue-500 dark:text-blue-400 focus:ring-blue-600 h-4 text-blue-600 w-4"> <label for="plan-enterprise" class="dark:text-white font-medium ms-3 text-gray-900 text-sm">Enterprise</label></div></div></fieldset>