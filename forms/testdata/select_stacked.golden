<div><label for="plan" class="block dark:text-white font-medium leading-6 text-gray-900 text-sm">Select a plan </label><select name="plan" id="plan" class="block border-0 caret-blue-600 dark:bg-gray-800 dark:caret-blue-400 dark:focus:ring-blue-500 dark:placeholder:text-gray-500 dark:ring-gray-700 dark:text-white focus:ring-2 focus:ring-blue-600 focus:ring-inset placeholder:text-gray-400 px-3 py-1.5 ring-1 ring-gray-300 ring-inset rounded-md shadow-xs sm:leading-6 sm:text-sm text-gray-900 transition-colors w-full"><option value="free">Free</option><option value="pro">Pro</option></select></div>