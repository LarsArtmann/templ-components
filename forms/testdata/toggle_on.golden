<label class="cursor-pointer inline-flex items-center"><input type="checkbox" name="notifications" class="peer sr-only" checked><div class="bg-gray-200 dark:bg-gray-700 dark:peer-checked:bg-blue-500 h-6 motion-reduce:transition-none peer-checked:bg-blue-600 relative rounded-full transition-colors w-11"><div class="absolute bg-white h-5 motion-reduce:transition-none peer-checked:translate-x-5 rounded-full shadow-sm start-0.5 top-0.5 transition-transform w-5"></div></div><span class="dark:text-white font-medium ms-3 text-gray-900 text-sm">Enable notifications</span></label>