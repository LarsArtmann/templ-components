<label class="cursor-pointer flex items-center w-fit"><input type="checkbox" role="switch" aria-checked="false" name="darkmode" class="peer sr-only"> <span class="bg-gray-200 dark:bg-gray-700 dark:peer-checked:bg-blue-500 h-6 motion-reduce:transition-none peer-checked:*:inset-s-5.5 peer-checked:bg-blue-600 relative rounded-full transition-colors w-11"><span class="absolute bg-white h-5 inset-s-0.5 motion-reduce:transition-none rounded-full shadow-sm top-0.5 transition-[inset-inline-start] w-5"></span></span> <span class="dark:text-white font-medium ms-3 text-gray-900 text-sm">Dark mode</span></label><script>
		if (!window.tcSwitchAttached) {
			window.tcSwitchAttached = true;
			function tcSyncSwitchState(t) {
				t.setAttribute('aria-checked', t.checked ? 'true' : 'false');
			}
			document.addEventListener('change', function(e) {
				var t = e.target;
				if (t && t.matches && t.matches('input[role="switch"]')) tcSyncSwitchState(t);
			}, true);
			window.addEventListener('pageshow', function() {
				document.querySelectorAll('input[role="switch"]').forEach(tcSyncSwitchState);
			});
		}
	</script>