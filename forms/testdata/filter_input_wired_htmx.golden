<search><form method="GET" class="flex-col inline-flex"><label for="user-search" class="block dark:text-gray-400 font-medium mb-1 text-gray-600 text-xs">Search users</label> <input type="search" id="user-search" name="q" value="ada" class="bg-white block border-0 caret-blue-600 dark:bg-gray-800 dark:caret-blue-400 dark:focus:ring-blue-500 dark:placeholder:text-gray-500 dark:ring-gray-600 dark:text-white focus:ring-2 focus:ring-blue-600 focus:ring-inset pe-8 placeholder:text-gray-400 ps-3 py-1.5 ring-1 ring-gray-300 ring-inset rounded-md text-gray-900 text-sm w-full" hx-get="/api/search" hx-target="#user-list" hx-trigger="input changed delay:300ms"> </form></search>