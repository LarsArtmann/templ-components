<div><label for="email" class="block dark:text-white font-medium leading-6 text-gray-900 text-sm">Email address <span class="dark:text-red-400 ms-0.5 text-red-500" aria-hidden="true">*</span></label><div class="relative"><input type="email" name="email" id="email" value="" enterkeyhint="next" inputmode="email" autocorrect="off" autocapitalize="off" spellcheck="false" class="block border-0 caret-blue-600 dark:bg-gray-800 dark:caret-blue-400 dark:focus:ring-red-500 dark:placeholder:text-gray-500 dark:ring-red-700 dark:text-white focus:ring-2 focus:ring-inset focus:ring-red-500 placeholder:text-gray-400 px-3 py-1.5 ring-1 ring-inset ring-red-300 rounded-md shadow-xs sm:leading-6 sm:text-sm text-gray-900 transition-colors w-full" required aria-required="true" aria-describedby="email-error email-help" aria-invalid="true"></div><p class="dark:text-red-400 mt-2 text-red-600 text-sm" role="alert" id="email-error">Enter a valid email address.</p><p id="email-help" class="dark:text-gray-400 mt-1 text-gray-500 text-sm">Use your work email.</p></div>