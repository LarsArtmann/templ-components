<form action="" method="POST" class="space-y-6" hx-post="/api/submit" hx-target="#form-region" hx-trigger="submit"><div class="bg-red-50 border border-red-200 dark:bg-red-900/30 dark:border-red-800 p-4 rounded-md" role="alert"><div class="flex"><div class="flex-shrink-0"><svg class="dark:text-red-500 h-5 text-red-400 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path></svg></div><div class="ms-3"><h3 class="dark:text-red-300 font-medium text-red-800 text-sm">1 error found</h3><div class="dark:text-red-400 mt-2 text-red-700 text-sm"><ul class="list-disc ps-5 space-y-1"><li><a href="#email" class="dark:hover:text-red-300 dark:text-red-400 hover:text-red-600 text-red-700 underline">Enter an email address with a domain.</a></li></ul></div></div></div></div><label class="block dark:text-white font-medium leading-6 text-gray-900 text-sm">Email address </label><div class="relative"><input type="email" name="email" value="ada@example" enterkeyhint="next" inputmode="email" class="block border-0 caret-blue-600 dark:bg-gray-800 dark:caret-blue-400 dark:focus:ring-red-500 dark:placeholder:text-gray-500 dark:ring-red-700 dark:text-white focus:ring-2 focus:ring-inset focus:ring-red-500 placeholder:text-gray-400 py-1.5 ring-1 ring-inset ring-red-300 rounded-md shadow-xs sm:leading-6 sm:text-sm text-gray-900 transition-colors w-full" aria-invalid="true"></div><p class="dark:text-red-400 mt-2 text-red-600 text-sm" role="alert">Enter an email address with a domain.</p></form>