<form method="get" class="flex flex-wrap gap-3 items-end" hx-get="/api/users" hx-push-url="true" hx-target="#results" hx-trigger="change from:find select, change from:find input[type=checkbox]" hx-indicator="#tc-filter-bar-NORMALIZED-indicator"><span id="tc-filter-bar-NORMALIZED-indicator" class="dark:text-gray-500 gap-1 htmx-indicator inline-flex items-center text-gray-400 text-xs">Loading…</span><noscript><button type="submit" class="bg-blue-600 dark:bg-blue-500 dark:focus-visible:outline-blue-500 focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 font-semibold inline-flex items-center px-3 py-1.5 rounded-md text-sm text-white">Apply</button></noscript></form>