<form method="get" action="/users" class="bg-white border border-gray-200 dark:bg-gray-900 dark:border-gray-700 flex flex-wrap gap-3 items-center p-4 rounded-lg sticky top-0 z-20" hx-get="/users" hx-push-url="true" hx-trigger="change from:find select, change from:find input[type=checkbox]" hx-indicator="#tc-filter-bar-NORMALIZED-indicator"><div class="flex-col inline-flex"><label for="status" class="block dark:text-gray-400 font-medium mb-1 text-gray-600 text-xs">Status</label> <select name="status" id="status" class="bg-white block border-0 caret-blue-600 dark:bg-gray-800 dark:caret-blue-400 dark:focus:ring-blue-500 dark:ring-gray-600 dark:text-white focus:ring-2 focus:ring-blue-600 focus:ring-inset pe-8 ps-3 py-1.5 ring-1 ring-gray-300 ring-inset rounded-md text-gray-900 text-sm" hx-get="" hx-target="" hx-trigger="change" aria-label="Status"><option value="">All</option><option value="active">Active</option></select> </div><span id="tc-filter-bar-NORMALIZED-indicator" class="dark:text-gray-500 gap-1 htmx-indicator inline-flex items-center text-gray-400 text-xs">Loading…</span><noscript><button type="submit" class="bg-blue-600 dark:bg-blue-500 dark:focus-visible:outline-blue-500 focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 font-semibold inline-flex items-center px-3 py-1.5 rounded-md text-sm text-white">Apply</button></noscript></form>