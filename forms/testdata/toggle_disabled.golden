<label class="cursor-not-allowed inline-flex items-center opacity-50"><input type="checkbox" name="readonly" class="peer sr-only" disabled><div class="bg-gray-200 dark:bg-gray-700 dark:peer-checked:bg-blue-500 h-6 motion-reduce:transition-none peer-checked:bg-blue-600 relative rounded-full transition-colors w-11"><div class="absolute bg-white h-5 motion-reduce:transition-none peer-checked:translate-x-5 rounded-full shadow-sm start-0.5 top-0.5 transition-transform w-5"></div></div><span class="dark:text-white font-medium ms-3 text-gray-900 text-sm">Read-only setting</span></label> <p class="dark:text-gray-400 mt-1 text-gray-500 text-sm">Locked by policy</p>