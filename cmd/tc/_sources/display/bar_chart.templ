package display

import (
	"fmt"

	"github.com/larsartmann/templ-components/utils"
)

// BarChart renders a CSS-based bar chart — no JavaScript, no SVG.
// Horizontal orientation shows label bars; vertical shows columns.
// The chart is responsive and dark-mode aware.
//
//	@display.BarChart(display.BarChartProps{
//	   Bars: []display.BarChartBar{
//	       {Label: "general", Value: 1200},
//	       {Label: "random", Value: 800},
//	       {Label: "dev", Value: 450},
//	   },
//	})
templ BarChart(props BarChartProps) {
	{{
		bars := props.Bars
		orient := props.Orient
		if !BarOrientIsValid(orient) {
			orient = BarHorizontal
		}
		barColor := string(props.BarColor)
		if barColor == "" {
			barColor = "bg-accent-600 dark:bg-accent-500"
		}
		labelWidth := props.LabelWidth
		if labelWidth == "" {
			labelWidth = "w-32"
		}
		emptyMsg := props.EmptyMessage
		if emptyMsg == "" {
			emptyMsg = "No data"
		}
		valueFmt := props.ValueFormat
		if valueFmt == nil {
			valueFmt = func(v float64) string { return fmt.Sprintf("%.0f", v) }
		}
		maxVal, minVal := barChartBounds(bars, props.Max)
		hasNegative := minVal < 0
		minBarW := props.MinBarWidth
		if minBarW == "" {
			minBarW = defaultMinBarWidth
		}
		gapClass := props.Gap
		if gapClass == "" {
			gapClass = defaultVerticalGap
		}
	}}
	if len(bars) == 0 {
		<p
			if props.ID != "" {
				id={ props.ID }
			}
			class={ utils.Class("text-sm text-gray-500 dark:text-gray-400", props.Class) }
		>{ emptyMsg }</p>
	} else if orient == BarVertical {
		{{
			heightVal := props.Height
			if heightVal == "" {
				heightVal = defaultVerticalHeight
			}

			negColor := string(props.NegativeBarColor)
			if negColor == "" {
				negColor = defaultNegativeBarColor
			}
		}}
		<div
			if props.ID != "" {
				id={ props.ID }
			}
			class={ utils.Class("flex overflow-x-auto", gapClass, utils.Ternary(props.MaxBarWidth != "", "justify-center", ""), props.Class) }
			style={ "height:" + heightVal }
			role="img"
			aria-label={ utils.Coalesce(props.AriaLabel, barChartFallbackName) }
		>
			for _, bar := range bars {
				{{ zeroPct, barTopPct, heightPct, negative := barChartSignedPlacement(bar.Value, maxVal, minVal) }}
				<div
					class={ utils.Class("flex h-full w-full flex-col items-center gap-1", minBarW, props.MaxBarWidth) }
					if bar.Tooltip != "" {
						title={ bar.Tooltip }
					}
				>
					<div class="relative w-full flex-1">
						if props.ShowBaseline || hasNegative {
							<div class="absolute inset-x-0 h-px bg-gray-200 dark:bg-gray-700" style={ "bottom:" + zeroPct }></div>
						}
						if negative {
							if props.ShowValues {
								<span class="absolute inset-x-0 text-center text-xs tabular-nums text-gray-600 dark:text-gray-400" style={ "top:calc(" + barTopPct + " + " + heightPct + ")" }>{ barValueLabel(bar, valueFmt) }</span>
							}
							<div class={ utils.Class("absolute inset-x-0 rounded-b", negColor, string(bar.Color)) } style={ "top:" + barTopPct + ";height:" + heightPct }></div>
						} else {
							if props.ShowValues {
								<span class="absolute inset-x-0 text-center text-xs tabular-nums text-gray-600 dark:text-gray-400" style={ "bottom:calc(" + zeroPct + " + " + heightPct + ")" }>{ barValueLabel(bar, valueFmt) }</span>
							}
							<div class={ utils.Class("absolute inset-x-0 rounded-t", barColor, string(bar.Color)) } style={ "bottom:" + zeroPct + ";height:" + heightPct }></div>
						}
					</div>
					<span class="w-full truncate text-center text-xs text-gray-500 dark:text-gray-400" title={ bar.Label }>
						{ truncateLabel(bar.Label, 12) }
					</span>
				</div>
			}
		</div>
	} else {
		<div
			if props.ID != "" {
				id={ props.ID }
			}
			class={ utils.Class("space-y-2", props.Class) }
			role="img"
			aria-label={ utils.Coalesce(props.AriaLabel, barChartFallbackName) }
		>
			for _, bar := range bars {
				<div
					class="flex items-center gap-3"
					if bar.Tooltip != "" {
						title={ bar.Tooltip }
					}
				>
					if bar.Href != "" {
						<a
							href={ templ.SafeURL(bar.Href) }
							class={ utils.Class("shrink-0 truncate text-xs font-medium text-gray-700 hover:text-accent-600 dark:text-gray-300 dark:hover:text-accent-400", labelWidth) }
							title={ bar.Label }
						>
							{ truncateLabel(bar.Label, 22) }
						</a>
					} else {
						<span class={ utils.Class("shrink-0 truncate text-xs font-medium text-gray-700 dark:text-gray-300", labelWidth) } title={ bar.Label }>
							{ truncateLabel(bar.Label, 22) }
						</span>
					}
					<div class="flex-1 overflow-hidden rounded bg-gray-100 dark:bg-gray-800">
						<div
							class={ utils.Class("h-5 rounded bg-accent-600 dark:bg-accent-500", barColor, string(bar.Color)) }
							style={ "width:" + barPercentWidth(bar.Value, maxVal) }
						></div>
					</div>
					if props.ShowValues {
						<span class="w-16 shrink-0 text-end text-xs tabular-nums text-gray-600 dark:text-gray-400">
							{ barValueLabel(bar, valueFmt) }
						</span>
					}
				</div>
			}
		</div>
	}
}

// truncateLabel truncates a string to maxLen runes with an ellipsis. Trimming
// runes (not bytes) keeps multibyte labels valid UTF-8 — a byte cut split
// characters in half and rendered mojibake for international labels.
func truncateLabel(s string, maxLen int) string {
	runes := []rune(s)
	if len(runes) <= maxLen {
		return s
	}
	return string(runes[:maxLen-1]) + "…"
}
