package display

import (
	"fmt"

	"github.com/larsartmann/templ-components/utils"
)

// ListNoteVariant selects which count semantics ListNote renders.
type ListNoteVariant string

const (
	// ListNoteTruncated renders "Showing N of M. Narrow your search to see
	// more." — and only when Total > Shown (a truncated result set). This is
	// the default; the zero value behaves identically.
	ListNoteTruncated ListNoteVariant = "truncated"
	// ListNoteCount renders "Showing N items." (pluralized) — count-only,
	// unconditionally, with no total and no advice. For list semantics where
	// "N items in range" is the whole message (e.g. an event log between two
	// timestamps): the consumer already knows why the list is shaped this
	// way, so count-only is the honest hint — including "Showing 0 items."
	// for an empty-but-loaded window.
	ListNoteCount ListNoteVariant = "count"
	// ListNoteRange renders "Showing X–Y of Z." — cursor-paginated position
	// semantics: X–Y is the 1-based span of items on the current page (from
	// RangeFrom/RangeTo), Z is the match count (Total). Unlike the truncated
	// variant it always renders — a cursor journal has no "everything fits"
	// signal, and "Showing 193–216 of 237." on the last page is the honest
	// you-have-seen-it-all hint. An empty or unpositioned range (non-positive
	// RangeFrom/RangeTo) degrades to the count message.
	ListNoteRange ListNoteVariant = "range"
)

// ListNoteProps configures a "Showing N of M" truncation notice.
type ListNoteProps struct {
	utils.BaseProps
	// Shown is the number of items currently rendered.
	Shown int
	// Total is the unfiltered/cap-exceeding match count. Read by the
	// truncated variant ("N of M") and by ListNoteRange (the Z in
	// "X–Y of Z"); ignored by ListNoteCount.
	Total int
	// RangeFrom is the 1-based index of the first item on the current page
	// (ListNoteRange only). Non-positive values degrade to the count message.
	RangeFrom int
	// RangeTo is the 1-based index of the last item on the current page
	// (ListNoteRange only). Non-positive values degrade to the count message.
	RangeTo int
	// Variant selects count semantics. Defaults to ListNoteTruncated.
	Variant ListNoteVariant
}

// listNoteMessage returns the notice text and whether it renders at all.
// Unknown Variant values degrade to truncated semantics (graceful fallback).
func listNoteMessage(props ListNoteProps) (string, bool) {
	if props.Variant == ListNoteRange {
		if props.RangeFrom <= 0 || props.RangeTo <= 0 {
			return countMessage(props.Shown), true
		}

		return fmt.Sprintf("Showing %d–%d of %d.", props.RangeFrom, props.RangeTo, props.Total), true
	}

	if props.Variant == ListNoteCount {
		return countMessage(props.Shown), true
	}

	if props.Total <= props.Shown {
		return "", false
	}

	return fmt.Sprintf("Showing %d of %d. Narrow your search to see more.", props.Shown, props.Total), true
}

// countMessage renders the pluralized count-only phrasing shared by
// ListNoteCount and the ListNoteRange empty fallback.
func countMessage(shown int) string {
	item := "items"
	if shown == 1 {
		item = "item"
	}

	return fmt.Sprintf("Showing %d %s.", shown, item)
}

// listNoteShell renders the shared status div so both variants keep one
// class/ARIA source of truth.
templ listNoteShell(props ListNoteProps, message string) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ utils.Class("border-t border-gray-200 dark:border-gray-700 px-4 py-2.5 text-xs text-gray-500 dark:text-gray-400", props.Class) }
		role="status"
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		{ props.Attrs... }
	>
		{ message }
	</div>
}

// ListNote renders a "Showing N of M" hint when a list is truncated
// (ListNoteTruncated, the default: renders nothing when all rows fit), a
// count-only "Showing N items." hint (ListNoteCount: always renders —
// including zero — for list semantics), or a cursor-paginated position hint
// (ListNoteRange: "Showing X–Y of Z.", always renders).
//
//	@display.ListNote(display.ListNoteProps{Shown: 50, Total: 127})
//	@display.ListNote(display.ListNoteProps{Shown: 42, Variant: display.ListNoteCount})
//	@display.ListNote(display.ListNoteProps{RangeFrom: 193, RangeTo: 216, Total: 237, Variant: display.ListNoteRange})
templ ListNote(props ListNoteProps) {
	{{ message, visible := listNoteMessage(props) }}
	if visible {
		@listNoteShell(props, message)
	}
}
