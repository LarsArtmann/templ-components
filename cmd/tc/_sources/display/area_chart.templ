package display

// AreaChart renders a pure-SVG area chart with axes, gridlines, multi-series
// filled areas, optional dots, and a legend. Zero JavaScript — all rendering
// is server-side. Each series renders both a stroked line and a semi-transparent
// fill from the line down to the baseline.
//
//	@display.AreaChart(display.AreaChartProps{
//	    Series: []display.LineChartSeries{
//	        {Name: "Active Users", Values: []float64{120, 180, 250, 300, 280, 340}},
//	    },
//	    XAxisLabels: []string{"Jan", "Feb", "Mar", "Apr", "May", "Jun"},
//	})
templ AreaChart(props AreaChartProps) {
	{{
		width, height, style, emptyMsg := resolveLineAreaChartInputs(
			props.Width, props.Height, props.Style, props.EmptyMessage,
		)

		d := computeChartRenderData(
			width, height, props.Padding,
			props.Series, props.XAxisLabels,
			props.Min, props.Max,
			props.ShowGrid, props.ShowLegend,
			props.ValueFormat, emptyMsg,
			props.Class, props.AriaLabel, props.ID, props.Attrs,
			props.MaxTicks,
		)
	}}
	@lineAreaChartSVG(d, props.Series, style, chartSeriesRenderOpts{
		filled:      true,
		fillOpacity: areaChartFillOpacityStr(props.FillOpacity),
		showDots:    props.ShowDots,
	})
}
