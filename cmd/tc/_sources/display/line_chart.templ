package display

import (
	"fmt"

	"github.com/larsartmann/templ-components/utils"
)

// LineChart renders a pure-SVG line chart with Y-axis ticks, optional gridlines,
// multi-series support, data-point dots, and a legend. Zero JavaScript — all
// rendering is server-side. Dark-mode aware via Tailwind dark: variants.
//
//	@display.LineChart(display.LineChartProps{
//	    Series: []display.LineChartSeries{
//	        {Name: "Revenue", Values: []float64{10, 25, 40, 35, 60, 55, 80}},
//	    },
//	    XAxisLabels: []string{"Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"},
//	})
templ LineChart(props LineChartProps) {
	{{
		width := props.Width
		if width == 0 {
			width = lineChartDefaultWidth
		}
		height := props.Height
		if height == 0 {
			height = lineChartDefaultHeight
		}
		style := props.Style
		if style == "" {
			style = LineChartStyleLinear
		}
		emptyMsg := props.EmptyMessage
		if emptyMsg == "" {
			emptyMsg = lineChartDefaultEmptyMsg
		}

		d := computeChartRenderData(
			width, height, props.Padding,
			props.Series, props.XAxisLabels,
			props.Min, props.Max,
			props.ShowGrid, props.ShowLegend,
			props.ValueFormat, emptyMsg,
			props.Class, props.AriaLabel, props.ID, props.Attrs,
			props.MaxTicks,
		)
	}}
	<svg
		viewBox={ fmt.Sprintf("0 0 %d %d", d.Width, d.Height) }
		class={ utils.Class("w-full h-auto", d.Class) }
		role="img"
		if d.AriaLabel != "" {
			aria-label={ d.AriaLabel }
		} else {
			aria-hidden="true"
		}
		if d.ID != "" {
			id={ d.ID }
		}
		{ d.Attrs... }
	>
		if d.HasData {
			@chartAxes(d)
			for i, series := range props.Series {
				if len(series.Values) >= 2 {
					@chartSeriesGroup(d, series, i, style, chartSeriesRenderOpts{showDots: props.ShowDots})
				}
			}
			@chartLegend(d)
		} else {
			@chartEmptyStateMsg(d)
		}
	</svg>
}
