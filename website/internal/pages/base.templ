package pages

import (
	"encoding/json"

	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/layout"
)

// PageMeta describes one site page: head tags + chrome wiring.
type PageMeta struct {
	// Path is the URL path sans extension ("", "getting-started/installation").
	Path string
	// Title is the document <title> (and og:title / twitter:title).
	Title string
	// Description feeds the meta description, og:description, twitter:description.
	Description string
	// OGImage is the absolute URL of the social-share image.
	OGImage string
	// Scripts are defer-loaded JS URLs injected into <head> (CSP 'self').
	Scripts []string
}

// preloadedFonts are the first-paint-critical self-hosted woff2 files.
var preloadedFonts = []string{
	"/assets/fonts/space-grotesk-latin-400-normal.woff2",
	"/assets/fonts/space-grotesk-latin-700-normal.woff2",
	"/assets/fonts/jetbrains-mono-latin-400-normal.woff2",
}

// canonicalURL returns the absolute canonical URL for a page path.
func canonicalURL(path string) string {
	if path == "" {
		return SiteURL + "/"
	}
	return SiteURL + "/" + path
}

// softwareApplicationJSONLD marshals the schema.org SoftwareApplication
// metadata (ported byte-for-byte in meaning from the Astro LandingLayout).
func softwareApplicationJSONLD() string {
	doc := map[string]any{
		"@context":           "https://schema.org",
		"@type":              "SoftwareApplication",
		"name":               SiteName,
		"description":        SiteDescription,
		"url":                SiteURL,
		"applicationCategory": "DeveloperApplication",
		"operatingSystem":    "Go",
		"programmingLanguage": "Go",
		"license":            "https://opensource.org/licenses/MIT",
		"author": map[string]string{
			"@type": "Person",
			"name":  AuthorName,
			"url":   AuthorURL,
		},
		"offers": map[string]string{
			"@type":        "Offer",
			"price":        "0",
			"priceCurrency": "USD",
		},
	}
	data, err := json.Marshal(doc)
	if err != nil {
		return ""
	}
	return string(data)
}

// pageProps builds the library layout.PageProps for a site page. The site is
// static: HTMX injection is disabled (no HTMXVersion/HTMXSrc) and the CSS is
// the site's compiled Tailwind entry.
func pageProps(m PageMeta, nonce string) layout.PageProps {
	p := layout.DefaultPageProps()
	p.Title = m.Title
	p.Description = m.Description
	p.Locale = "en"
	p.CSSPath = "/assets/app.css"
	p.Favicon = "/favicon.svg"
	p.OGImage = m.OGImage
	p.ThemeColor = "#2563eb"
	p.DarkThemeColor = "#2563eb"
	p.HTMXVersion = ""
	p.HTMXSrc = ""
	p.HTMXResponseTargets = false
	p.Nonce = nonce
	p.BodyClass = "font-sans bg-bg-primary text-text-secondary antialiased leading-relaxed"
	p.SkipLinkText = "Skip to content"
	p.SEO = layout.SEOMeta{
		Canonical: canonicalURL(m.Path),
		JSONLD:    softwareApplicationJSONLD(),
	}
	p.HeadContent = headExtras(m)
	p.Footer = Footer(nonce)
	return p
}

// Page renders a full site document through the library's layout.Base:
// skip link, ThemeScript (FOUC guard, localStorage-compatible with the old
// site), SEO head, and the shared chrome (header in-flow, footer via slot).
templ Page(m PageMeta, nonce string) {
	@layout.Base(pageProps(m, nonce)) {
		@Header(nonce)
		{ children... }
	}
}

templ headExtras(m PageMeta) {
	<link rel="manifest" href="/manifest.json"/>
	for _, font := range preloadedFonts {
		<link rel="preload" href={ font } as="font" type="font/woff2" crossorigin="anonymous"/>
	}
	for _, src := range m.Scripts {
		<script src={ src } defer></script>
	}
}

// githubMark is the GitHub brand path (brand icons are outside the library's
// heroicons catalogue by design; rendered through the library's documented
// consumer icon extension point).
const githubMark = "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"

// githubIcon renders the GitHub brand mark at site scale.
templ githubIcon(class string) {
	@icons.Render(icons.CustomIcon{Paths: []string{githubMark}}, class)
}

// filledStar is the filled star used by the GitHub-stars CTA.
const filledStar = "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"

templ filledStarIcon(class string) {
	@icons.Render(icons.CustomIcon{Paths: []string{filledStar}, Fill: "currentColor"}, class)
}
