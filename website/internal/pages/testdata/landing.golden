rk mode"><svg class="dark:hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path></svg><svg class="dark:block h-5 hidden w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"></path></svg></button> <script nonce="golden-test-nonce">
			(function() {
				var html = document.documentElement;

				function syncToggleAria(btn) {
					if (btn) btn.setAttribute('aria-checked', String(html.classList.contains('dark')));
				}

				// Always sync aria-checked, even after htmx swap re-injects a button
				// with the hardcoded aria-checked="false". This runs on every render;
				// the click listener below is guarded so it only attaches once.
				document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);

				if (!window.tcThemeToggleAttached) {
					window.tcThemeToggleAttached = true;

					document.addEventListener('click', function(e) {
					var btn = e.target.closest('[data-theme-toggle]');
					if (!btn) return;
					var isDark = html.classList.contains('dark');
					if (isDark) {
						html.classList.remove('dark');
						try { localStorage.setItem('theme', 'light'); } catch(e) {}
					} else {
						html.classList.add('dark');
						try { localStorage.setItem('theme', 'dark'); } catch(e) {}
					}
					html.style.colorScheme = isDark ? 'light' : 'dark';
					document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);
					});
				}
			})();
		</script><a href="/getting-started/installation" class="duration-150 hover:text-text-primary nav-link no-underline text-sm text-text-secondary transition-colors">Docs</a> <a href="https://github.com/larsartmann/templ-components" target="_blank" rel="noopener noreferrer" class="duration-150 flex gap-1.5 hover:text-text-primary items-center nav-link no-underline text-sm text-text-secondary transition-colors"><span class="text-text-muted"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg></span> GitHub</a></div></div></nav></header> <section class="flex items-center justify-center overflow-hidden pb-20 pt-36 relative"><div class="-translate-x-1/2 absolute bg-accent/5 blur-[140px] h-[500px] left-1/2 pointer-events-none rounded-full top-1/4 w-[900px]"></div><div class="max-w-3xl mx-auto px-6 relative text-center xl:max-w-7xl"><div class="backdrop-blur-sm bg-bg-card-solid border border-border font-mono gap-2 inline-flex items-center mb-8 px-3 py-1.5 rounded-full text-text-secondary text-xs"><span class="flex h-2 relative w-2"><span class="absolute animate-pulse-dot bg-accent h-full inline-flex rounded-full w-full"></span> <span class="bg-accent h-2 inline-flex relative rounded-full w-2"></span></span> Server-rendered UI for Go</div><h1 class="font-bold leading-[1.05] mb-6 text-[clamp(2.75rem,8vw,4.5rem)] text-text-primary tracking-tighter">Build Go web apps<br>without a <span class="text-accent">frontend framework</span>.</h1><p class="leading-relaxed max-w-2xl mb-10 mx-auto text-[clamp(1.0625rem,2.5vw,1.25rem)] text-text-secondary">123 server-rendered components for templ + HTMX + Tailwind CSS v4. Type-safe props, dark mode built-in, CSP-ready, zero Node.js.</p><div class="flex flex-col gap-3 items-center justify-center mb-12 sm:flex-row"><a href="/getting-started/installation" class="bg-blue-600 cursor-pointer dark:bg-blue-500 dark:focus-visible:outline-blue-500 dark:hover:bg-blue-400 disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 font-semibold hover:-translate-y-0.5 hover:bg-blue-500 hover:shadow-accent/30 inline-flex items-center justify-center px-6 py-3 rounded-md shadow-accent/20 shadow-lg text-sm text-white transition-colors"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg>Get Started</a><a href="https://templcomponents-demo-132045829579.us-central1.run.app" class="bg-transparent border border-border cursor-pointer dark:hover:bg-gray-700 dark:text-gray-200 disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 font-semibold hover:-translate-y-0.5 hover:bg-transparent hover:border-border-hover hover:text-text-primary inline-flex items-center justify-center px-6 py-3.5 rounded-md text-sm text-text-secondary transition-colors" target="_blank" rel="noopener noreferrer"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round"