			(function() {
				var html = document.documentElement;

				function syncToggleAria(btn) {
					if (btn) btn.setAttribute('aria-checked', String(html.classList.contains('dark')));
				}

				// Always sync aria-checked, even after htmx swap re-injects a button
				// with the hardcoded aria-checked="false". This runs on every render;
				// the click listener below is guarded so it only attaches once.
				document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);

				if (!window.tcThemeToggleAttached) {
					window.tcThemeToggleAttached = true;

					document.addEventListener('click', function(e) {
					var btn = e.target.closest('[data-theme-toggle]');
					if (!btn) return;
					var isDark = html.classList.contains('dark');
					if (isDark) {
						html.classList.remove('dark');
						try { localStorage.setItem('theme', 'light'); } catch(e) {}
					} else {
						html.classList.add('dark');
						try { localStorage.setItem('theme', 'dark'); } catch(e) {}
					}
					html.style.colorScheme = isDark ? 'light' : 'dark';
					document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);
					});
				}
			})();
		</script><a href="/sales" class="duration-150 hover:text-text-primary nav-link no-underline text-sm text-text-secondary transition-colors">Why</a> <a href="/getting-started/installation" class="duration-150 hover:text-text-primary nav-link no-underline text-sm text-text-secondary transition-colors">Docs</a> <a href="https://github.com/larsartmann/templ-components" target="_blank" rel="noopener noreferrer" class="duration-150 flex gap-1.5 hover:text-text-primary items-center nav-link no-underline text-sm text-text-secondary transition-colors"><span class="text-text-muted"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg></span> GitHub</a></div></div></nav></header> <main id="main-content" class="bg-gray-50 dark:bg-gray-900 flex items-center justify-center min-h-screen p-4" aria-label="404 — Page not found" tabindex="-1"><div class="max-w-xl text-center w-full"><p class="bg-clip-text bg-gradient-to-br dark:from-blue-500 dark:to-indigo-400 dark:via-blue-400 font-extrabold from-blue-600 leading-none select-none sm:text-[10rem] text-[8rem] text-transparent to-indigo-500 tracking-tighter via-blue-500" aria-hidden="true">404</p><h1 class="dark:text-white font-bold mt-4 sm:text-3xl text-2xl text-gray-900">Page not foun