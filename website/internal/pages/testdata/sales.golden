<!doctype html><html lang="en" class="h-full"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="color-scheme" content="light dark"><title>Why templ-components — The Case for Server-Rendered UI in Go</title><meta name="description" content="Every argument for templ-components on one page: type-safe, server-rendered Go components for templ, HTMX, and Tailwind v4. CSP-ready, dark-mode tested, zero Node.js. MIT licensed."><link rel="canonical" href="https://templcomponents.lars.software/sales"><script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","applicationCategory":"DeveloperApplication","author":{"@type":"Person","name":"LarsArtmann","url":"https://larsartmann.com/"},"description":"A pure Tailwind CSS v4 component library for Go's templ engine with first-class HTMX integration. No DaisyUI, no Node.js, no framework lock-in.","license":"https://opensource.org/licenses/MIT","name":"templ-components","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"operatingSystem":"Go","programmingLanguage":"Go","url":"https://templcomponents.lars.software"}</script><link rel="icon" href="/favicon.svg"><meta name="theme-color" content="#2563eb" media="(prefers-color-scheme: light)"><meta name="theme-color" content="#2563eb" media="(prefers-color-scheme: dark)"><meta property="og:title" content="Why templ-components — The Case for Server-Rendered UI in Go"><meta property="og:description" content="Every argument for templ-components on one page: type-safe, server-rendered Go components for templ, HTMX, and Tailwind v4. CSP-ready, dark-mode tested, zero Node.js. MIT licensed."><meta property="og:type" content="website"><meta property="og:image" content="https://templcomponents.lars.software/og/sales.png"><meta property="og:locale" content="en"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Why templ-components — The Case for Server-Rendered UI in Go"><meta name="twitter:description" content="Every argument for templ-components on one page: type-safe, server-rendered Go components for templ, HTMX, and Tailwind v4. CSP-ready, dark-mode tested, zero Node.js. MIT licensed."><meta name="twitter:image" content="https://templcomponents.lars.software/og/sales.png"><script nonce="golden-test-nonce">
			(function() {
				var theme;
				try { theme = localStorage.getItem('theme'); } catch(e) {}
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				var isDark = theme === 'dark' || (!theme && prefersDark);
				if (isDark) {
					document.documentElement.classList.add('dark');
				}
				document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
			})();
		</script><link rel="stylesheet" href="/assets/app.css"><link rel="manifest" href="/manifest.json"><link rel="stylesheet" href="/assets/css/chroma.css"><link rel="preload" href="/assets/fonts/space-grotesk-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous"><link rel="preload" href="/assets/fonts/space-grotesk-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous"><link rel="preload" href="/assets/fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous"><script src="/assets/js/theme-sync.js" defer></script><script src="/assets/js/header.js" defer></script><script src="/assets/js/search.js" defer></script><script src="/assets/js/animations.js" defer></script><script src="/assets/js/newsletter.js" defer></script></head><body class="antialiased bg-bg-primary font-sans leading-relaxed text-text-secondary"><a href="#main-content" class="dark:focus:bg-blue-500 dark:focus:ring-blue-400 dark:focus:ring-offset-gray-900 focus:absolute focus:bg-blue-600 focus:not-sr-only focus:outline-hidden focus:px-4 focus:py-2 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:rounded-md focus:shadow-lg focus:start-2 focus:text-white focus:top-2 focus:z-50 sr-only">Skip to content</a> <header><nav class="backdrop-blur-xl bg-bg-primary/60 border-b border-border fixed left-0 right-0 top-0 z-50" aria-label="Main navigation"><div class="flex h-16 items-center justify-between max-w-7xl mx-auto px-6"><a href="/" class="flex gap-2.5 group items-center no-underline"><svg class="duration-200 group-hover:rotate-12 transition-transform" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="templ-components logo"><rect width="28" height="28" rx="6" class="fill-accent"></rect> <path d="M10 9L5 14l5 5M18 9l5 5-5 5M15.5 7l-3 14" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="font-semibold text-base text-text-primary tracking-tight">templ-components</span></a> <button class="bg-transparent border-none cursor-pointer hover:text-text-primary lg:hidden nav-toggle p-1 text-text-muted transition-colors" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-links"><span class="menu-icon"><svg class="h-[22px] w-[22px]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path></svg></span> <span class="close-icon hidden"><svg class="h-[22px] w-[22px]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg></span></button><div class="[&.open]:max-sm:flex flex gap-5 items-center max-sm:absolute max-sm:backdrop-blur-[40px] max-sm:bg-bg-primary max-sm:border-b max-sm:border-border max-sm:flex-col max-sm:gap-4 max-sm:hidden max-sm:inset-x-0 max-sm:p-6 max-sm:top-16 nav-links" id="nav-links"><div class="doc-search-wrap"><label class="sr-only" for="doc-search-input">Search documentation</label> <input type="text" id="doc-search-input" class="doc-search max-sm:w-full" placeholder="Search docs…" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="doc-search-results" aria-autocomplete="list"><div class="doc-search-results hidden" id="doc-search-results" role="listbox" aria-label="Search results"></div></div><button type="button" class="dark:hover:bg-gray-800 dark:hover:text-gray-300 dark:text-gray-500 hover:bg-gray-100 hover:text-gray-500 motion-reduce:duration-0 motion-reduce:transition-none p-2 rounded-md text-gray-400 transition-colors" data-theme-toggle role="switch" aria-checked="false" aria-label="Toggle light/dark mode"><svg class="dark:hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path></svg><svg class="dark:block h-5 hidden w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"></path></svg></button> <script nonce="golden-test-nonce">
			(function() {
				var html = document.documentElement;

				function syncToggleAria(btn) {
					if (btn) btn.setAttribute('aria-checked', String(html.classList.contains('dark')));
				}

				// Always sync aria-checked, even after htmx swap re-injects a button
				// with the hardcoded aria-checked="false". This runs on every render;
				// the click listener below is guarded so it only attaches once.
				document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);

				if (!window.tcThemeToggleAttached) {
					window.tcThemeToggleAttached = true;

					document.addEventListener('click', function(e) {
					var btn = e.target.closest('[data-theme-toggle]');
					if (!btn) return;
					var isDark = html.classList.contains('dark');
					if (isDark) {
						html.classList.remove('dark');
						try { localStorage.setItem('theme', 'light'); } catch(e) {}
					} else {
						html.classList.add('dark');
						try { localStorage.setItem('theme', 'dark'); } catch(e) {}
					}
					html.style.colorScheme = isDark ? 'light' : 'dark';
					document.querySelectorAll('[data-theme-toggle]').forEach(syncToggleAria);
					});
				}
			})();
		</script><a href="/sales" class="duration-150 hover:text-text-primary nav-link no-underline text-sm text-text-secondary transition-colors">Why</a> <a href="/getting-started/installation" class="duration-150 hover:text-text-primary nav-link no-underline text-sm text-text-secondary transition-colors">Docs</a> <a href="https://github.com/larsartmann/templ-components" target="_blank" rel="noopener noreferrer" class="duration-150 flex gap-1.5 hover:text-text-primary items-center nav-link no-underline text-sm text-text-secondary transition-colors"><span class="text-text-muted"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg></span> GitHub</a></div></div></nav></header> <main id="main-content" tabindex="-1" class="flex-1"><section class="flex items-center justify-center overflow-hidden pb-20 pt-36 relative"><div class="-translate-x-1/2 absolute bg-accent/5 blur-[140px] h-[500px] left-1/2 pointer-events-none rounded-full top-1/4 w-[900px]"></div><div class="max-w-3xl mx-auto px-6 relative text-center"><div class="flex justify-center mb-8"><span class="bg-blue-50 dark:bg-blue-900/30 dark:text-blue-300 font-medium inline-flex items-center px-2.5 py-0.5 rounded-full text-blue-800 text-xs"><span class="bg-blue-500 h-1.5 me-1.5 rounded-full w-1.5" aria-hidden="true"></span> For Go teams shipping web apps</span></div><h1 class="font-bold leading-[1.05] mb-6 text-[clamp(2.5rem,7vw,4rem)] text-text-primary tracking-tighter">Build complete UIs from Go —<br>without <span class="text-accent">the frontend stack</span>.</h1><p class="leading-relaxed max-w-2xl mb-10 mx-auto text-[clamp(1.0625rem,2.5vw,1.25rem)] text-text-secondary">123 server-rendered components for templ, HTMX, and Tailwind v4. Every button, card, and accordion on this page is rendered by the library it sells — view source and look for the framework.</p><div class="flex items-center justify-center mb-6"><a href="/getting-started/installation" class="bg-blue-600 cursor-pointer dark:bg-blue-500 dark:focus-visible:outline-blue-500 dark:hover:bg-blue-400 disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 font-semibold hover:-translate-y-0.5 hover:bg-blue-500 hover:shadow-accent/30 inline-flex items-center justify-center px-6 py-3 rounded-md shadow-accent/20 shadow-lg text-sm text-white transition-colors"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg>Install templ-components</a></div><div class="flex flex-wrap gap-2 items-center justify-center mb-14"><a href="https://github.com/larsartmann/templ-components/blob/master/LICENSE" class="bg-gray-100 dark:bg-gray-800 dark:text-gray-300 font-medium inline-flex items-center px-2 py-0.5 rounded-md text-gray-800 text-xs">MIT licensed</a><span class="bg-gray-100 dark:bg-gray-800 dark:text-gray-300 font-medium inline-flex items-center px-2 py-0.5 rounded-md text-gray-800 text-xs">No Node.js in your deploy</span><span class="bg-gray-100 dark:bg-gray-800 dark:text-gray-300 font-medium inline-flex items-center px-2 py-0.5 rounded-md text-gray-800 text-xs">Go 1.26+</span><a href="https://github.com/larsartmann/templ-components" class="bg-gray-100 dark:bg-gray-800 dark:text-gray-300 font-medium inline-flex items-center px-2 py-0.5 rounded-md text-gray-800 text-xs">1,024 Stars</a></div><div class="text-left"><div class="border-gray-200 border-y dark:border-gray-700 dark:text-gray-400 font-mono leading-relaxed py-3 tc-log text-[0.8125rem] text-gray-600 text-start" role="log" aria-label="Install workflow: go get the library, run templ generate and go build, then serve HTML from net/http with no Node packages installed"><div class="tc-log-line"><span class="dark:text-gray-500 me-3 text-gray-400">$</span> <span class="dark:text-blue-400 font-medium inline-block me-2 min-w-12 text-blue-600">shell</span> go get github.com/larsartmann/templ-components@latest</div><div class="tc-log-line"><span class="dark:text-gray-500 me-3 text-gray-400">$</span> <span class="dark:text-gray-400 font-medium inline-block me-2 min-w-12 text-gray-500">shell</span> templ generate ./... &amp;&amp; go build ./...</div><div class="tc-log-line"><span class="dark:text-gray-500 me-3 text-gray-400">→</span> <span class="dark:text-green-400 font-medium inline-block me-2 min-w-12 text-green-600">done</span> 123 components · 105 icons · zero Node packages installed</div><div class="tc-log-line"><span class="dark:text-gray-500 me-3 text-gray-400">→</span> <span class="dark:text-green-400 font-medium inline-block me-2 min-w-12 text-green-600">done</span> HTML served from net/http — there is no hydration step</div></div></div></div></section> <section class="py-24 relative" data-animate id="problem"><div class="max-w-7xl mx-auto px-6"><div><div class="mb-12 text-center"><div class="font-mono inline-block mb-3 text-accent text-xs tracking-[0.2em] uppercase">The problem</div><h2 class="font-bold mb-4 text-[clamp(1.625rem,4vw,2.25rem)] text-text-primary tracking-tight">Every Go web app pays a frontend tax.</h2><p class="max-w-2xl mx-auto text-base text-text-secondary">The moment a Go service needs a real UI, someone hands you a second stack. Recurring costs — recognize them?</p></div><div class="gap-3 grid md:grid-cols-3"><div class="backdrop-blur-sm bg-bg-card border border-border dark:bg-bg-card dark:border-border overflow-hidden print:bg-transparent print:border-0 print:shadow-none rounded-xl shadow-xs"><div class="border-b border-gray-200 dark:border-gray-700 flex items-center justify-between px-4 py-4 sm:px-6"><div><h3 class="break-after-avoid dark:text-white font-semibold leading-6 text-base text-gray-900">Two toolchains for one product</h3></div></div><div class="px-6 py-6"><p class="leading-relaxed m-0 text-sm text-text-muted">Node modules, a bundler, framework upgrades, and a lockfile that drifts — maintained next to the Go service that actually holds your business logic.</p></div></div><div class="backdrop-blur-sm bg-bg-card border border-border dark:bg-bg-card dark:border-border overflow-hidden print:bg-transparent print:border-0 print:shadow-none rounded-xl shadow-xs"><div class="border-b border-gray-200 dark:border-gray-700 flex items-center justify-between px-4 py-4 sm:px-6"><div><h3 class="break-after-avoid dark:text-white font-semibold leading-6 text-base text-gray-900">Two languages for one feature</h3></div></div><div class="px-6 py-6"><p class="leading-relaxed m-0 text-sm text-text-muted">A form becomes an API handler, a client store, a schema, and a fetch layer. Every field exists four times, and each copy can rot independently.</p></div></div><div class="backdrop-blur-sm bg-bg-card border border-border dark:bg-bg-card dark:border-border overflow-hidden print:bg-transparent print:border-0 print:shadow-none rounded-xl shadow-xs"><div class="border-b border-gray-200 dark:border-gray-700 flex items-center justify-between px-4 py-4 sm:px-6"><div><h3 class="break-after-avoid dark:text-white font-semibold leading-6 text-base text-gray-900">UI debt you inherit by default</h3></div></div><div class="px-6 py-6"><p class="leading-relaxed m-0 text-sm text-text-muted">Focus traps, aria wiring, dark mode, CSP nonces: the details that make UI feel finished are exactly the ones unassisted SPA boilerplate leaves out.</p></div></div></div></div></div></section> <section class="py-24 relative" data-animate><div class="max-w-7xl mx-auto px-6"><div><div class="mb-12 text-center"><div class="font-mono inline-block mb-3 text-accent text-xs tracking-[0.2em] uppercase">The alternative</div><h2 class="font-bold mb-4 text-[clamp(1.625rem,4vw,2.25rem)] text-text-primary tracking-tight">Render the UI where the data already lives.</h2><p class="max-w-2xl mx-auto text-base text-text-secondary">The library takes the unfinished details off your plate — typed, tested, and documented once, for every component.</p></div><div class="gap-3 grid sm:grid-cols-2"><div class="backdrop-blur-sm bg-bg-card border border-border dark:bg-bg-card dark:border-border overflow-hidden p-8 print:bg-transparent print:border-0 print:shadow-none rounded-xl shadow-xs"><div class="bg-accent-dim border border-border-accent flex h-11 items-center justify-center mb-4 rounded-lg text-accent w-11"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"></path></svg></div> <h3 class="font-semibold mb-2 text-base text-text-primary">Invalid states are compile errors</h3><p class="leading-relaxed m-0 text-sm text-text-muted">Typed string enums on every closed set — variant, size, tone, method. Pass an unknown value and the build fails before a browser ever opens.</p></div><div class="backdrop-blur-sm bg-bg-card border border-border dark:bg-bg-card dark:border-border overflow-hidden p-8 print:bg-transparent print:border-0 print:shadow-none rounded-xl shadow-xs"><div class="bg-accent-dim border border-border-accent flex h-11 items-center justify-center mb-4 rounded-lg text-accent w-11"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"></path></svg></div> <h3 class="font-semibold mb-2 text-base text-text-primary">Go is the whole pipeline</h3><p class="leading-relaxed m-0 text-sm text-text-muted">templ generate and go build. CSS comes from one Tailwind v4 entry file. No pnpm, no bundler config, no node_modules directory in your deploy artifact.</p></div><div class="backdrop-blur-sm bg-bg-card border border-border dark:bg-bg-card dark:border-border overflow-hidden p-8 print:bg-transparent print:border-0 print:shadow-none rounded-xl shadow-xs"><div class="bg-accent-dim border border-border-accent flex h-11 items-center justify-center mb-4 rounded-lg text-accent w-11"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div> <h3 class="font-semibold mb-2 text-base text-text-primary">CSP-safe without ceremony</h3><p class="leading-relaxed m-0 text-sm text-text-muted">Inline scripts ship with nonces, no eval, no inline handlers. An integration suite renders every component and fails if a single script tag goes out naked.</p></div><div class="backdrop-blur-sm bg-bg-card border border-border dark:bg-bg-card dark:border-border overflow-hidden p-8 print:bg-transparent print:border-0 print:shadow-none rounded-xl shadow-xs"><div class="bg-accent-dim border border-border-accent flex h-11 items-center justify-center mb-4 rounded-lg text-accent w-11"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path></svg></div> <h3 class="font-semibold mb-2 text-base text-text-primary">Accessible and dark by default</h3><p class="leading-relaxed m-0 text-sm text-text-muted">Every component carries dark-mode variants and reduced-motion fallbacks — enforced by regression tests, not style-guide memos. Accessibility findings gate the build.</p></div></div></div></div></section> <section class="py-24 relative" data-animate id="proof"><div class="max-w-5xl mx-auto px-6"><div><div class="mb-12 text-center"><div class="font-mono inline-block mb-3 text-accent text-xs tracking-[0.2em] uppercase">Proof</div><h2 class="font-bold mb-4 text-[clamp(1.625rem,4vw,2.25rem)] text-text-primary tracking-tight">This page is the demo.</h2><p class="max-w-2xl mx-auto text-base text-text-secondary">The stat cards below, the copy button, the FAQ accordion — all rendered by library components. No client framework loads anywhere on this page.</p></div><div class="gap-3 grid lg:grid-cols-4 mb-8 sm:grid-cols-2"><div class="bg-white border border-gray-200 dark:bg-bg-card-solid dark:border-border p-5 print:bg-transparent print:border-0 print:shadow-none shadow-xs"><div class="flex gap-4 items-center"><div class="bg-blue-50 dark:bg-blue-900/30 flex flex-shrink-0 h-12 items-center justify-center rounded-lg w-12"><svg class="dark:text-blue-400 h-6 text-blue-600 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"></path></svg></div><dl class="flex-1 min-w-0"><div class="flex flex-col mt-1"><dt class="dark:text-gray-400 font-medium text-gray-500 text-sm truncate">Components</dt><dd class="dark:text-white font-semibold text-2xl text-gray-900">123 </dd></div></dl></div></div><div class="bg-white border border-gray-200 dark:bg-bg-card-solid dark:border-border p-5 print:bg-transparent print:border-0 print:shadow-none shadow-xs"><div class="flex gap-4 items-center"><div class="bg-purple-50 dark:bg-purple-900/30 flex flex-shrink-0 h-12 items-center justify-center rounded-lg w-12"><svg class="dark:text-purple-400 h-6 text-purple-600 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l2.909-5.909a2.25 2.25 0 013.182 0l2.909 2.909m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"></path></svg></div><dl class="flex-1 min-w-0"><div class="flex flex-col mt-1"><dt class="dark:text-gray-400 font-medium text-gray-500 text-sm truncate">SVG icons</dt><dd class="dark:text-white font-semibold text-2xl text-gray-900">105 </dd></div></dl></div></div><div class="bg-white border border-gray-200 dark:bg-bg-card-solid dark:border-border p-5 print:bg-transparent print:border-0 print:shadow-none shadow-xs"><div class="flex gap-4 items-center"><div class="bg-green-50 dark:bg-green-900/30 flex flex-shrink-0 h-12 items-center justify-center rounded-lg w-12"><svg class="dark:text-green-400 h-6 text-green-600 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"></path></svg></div><dl class="flex-1 min-w-0"><div class="flex flex-col mt-1"><dt class="dark:text-gray-400 font-medium text-gray-500 text-sm truncate">Typed enums</dt><dd class="dark:text-white font-semibold text-2xl text-gray-900">63 </dd></div></dl></div></div><div class="bg-white border border-gray-200 dark:bg-bg-card-solid dark:border-border p-5 print:bg-transparent print:border-0 print:shadow-none shadow-xs"><div class="flex gap-4 items-center"><div class="bg-yellow-50 dark:bg-yellow-900/30 flex flex-shrink-0 h-12 items-center justify-center rounded-lg w-12"><svg class="dark:text-yellow-400 h-6 text-yellow-600 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"></path></svg></div><dl class="flex-1 min-w-0"><div class="flex flex-col mt-1"><dt class="dark:text-gray-400 font-medium text-gray-500 text-sm truncate">Go modules</dt><dd class="dark:text-white font-semibold text-2xl text-gray-900">7 </dd></div></dl></div></div></div><div class="bg-bg-card border border-border flex flex-col gap-4 p-5 rounded-xl sm:flex-row sm:items-center"><code class="bg-code-inline-bg/60 flex-1 font-mono min-w-0 overflow-x-auto px-3 py-2 rounded text-accent text-sm">go get github.com/larsartmann/templ-components@latest</code><button type="button" data-tc-copy="go get github.com/larsartmann/templ-components@latest" data-tc-copy-label="Copied!" class="bg-gray-50 cursor-pointer dark:bg-gray-700 dark:focus-visible:ring-blue-400 dark:hover:bg-gray-600 dark:ring-gray-600 dark:text-gray-200 focus-visible:ring-2 focus-visible:ring-blue-500 focus:outline-none font-medium gap-1.5 hover:bg-gray-100 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-2.5 py-1 ring-1 ring-gray-300 ring-inset rounded-md text-gray-700 text-xs transition-colors"><span data-tc-copy-text role="status" aria-live="polite" class="dark:text-gray-200 text-gray-700">Copy</span></button><script nonce="golden-test-nonce">
if(!window.tcCopyAttached){window.tcCopyAttached=true;function tcSwapLabel(el,label,original){if(el)el.textContent=label;setTimeout(function(){if(el)el.textContent=original;},2000);}function tcFallbackCopy(text,done){var ta=document.createElement('textarea');ta.value=text;ta.style.cssText='position:fixed;top:-9999px;left:-9999px';document.body.appendChild(ta);ta.focus();ta.select();try{document.execCommand('copy');done();}catch(e){}document.body.removeChild(ta);}document.addEventListener('click',function(e){var btn=e.target.closest('[data-tc-copy]');if(!btn)return;e.preventDefault();var text=btn.getAttribute('data-tc-copy');var label=btn.getAttribute('data-tc-copy-label')||'Copied!';var labelEl=btn.querySelector('[data-tc-copy-text]');var original=labelEl?labelEl.textContent:'';if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(function(){tcSwapLabel(labelEl,label,original);}).catch(function(){tcFallbackCopy(text,function(){tcSwapLabel(labelEl,label,original);});});}else{tcFallbackCopy(text,function(){tcSwapLabel(labelEl,label,original);});}});}
</script>
</div></div></div></section> <section class="py-24 relative" data-animate id="faq"><div class="max-w-3xl mx-auto px-6"><div><div class="mb-12 text-center"><div class="font-mono inline-block mb-3 text-accent text-xs tracking-[0.2em] uppercase">Objections, handled</div><h2 class="font-bold mb-4 text-[clamp(1.625rem,4vw,2.25rem)] text-text-primary tracking-tight">The questions you would ask in review.</h2></div><div class="[&amp;&gt;details]:bg-bg-card-solid [&amp;&gt;details]:dark:bg-bg-card-solid border border-border dark:border-border dark:divide-border divide-border divide-y overflow-hidden rounded-lg"><details class="bg-white dark:bg-gray-900" id="sales-faq-ready" open><summary class="cursor-pointer dark:focus:ring-blue-400 dark:hover:bg-gray-800 dark:text-white flex focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:ring-inset font-medium hover:bg-gray-50 items-center justify-between list-none px-4 py-4 text-gray-900 text-sm text-start w-full"><span>Is it production-ready?</span> <svg data-tc-chevron class="dark:text-gray-400 h-5 text-gray-500 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg></summary><div class="dark:text-gray-400 pb-4 px-4 text-gray-600 text-sm"><p class="leading-relaxed m-0 text-sm text-text-secondary">It is. The library is at v1 under semantic versioning, and every component ships behind <a href="/guides/invariants" class="dark:text-accent-light hover:text-accent-hover text-accent underline underline-offset-2">three regression layers</a>: HTML golden tests, pixel-level visual tests in headless Chromium, and an axe-core accessibility gate that fails the build on serious violations. This website — docs included — is rendered through the library itself.</p></div></details><details class="bg-white dark:bg-gray-900" id="sales-faq-raw-html"><summary class="cursor-pointer dark:focus:ring-blue-400 dark:hover:bg-gray-800 dark:text-white flex focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:ring-inset font-medium hover:bg-gray-50 items-center justify-between list-none px-4 py-4 text-gray-900 text-sm text-start w-full"><span>Why not just write raw HTML in Go?</span> <svg data-tc-chevron class="dark:text-gray-400 h-5 text-gray-500 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg></summary><div class="dark:text-gray-400 pb-4 px-4 text-gray-600 text-sm"><p class="leading-relaxed m-0 text-sm text-text-secondary">You can — templ already makes that pleasant. What the library adds is the long tail every team re-invents, badly and repeatedly: focus traps, aria wiring, dark-mode variants, CSP nonces, RTL-safe layout classes. Here they are typed, tested, and documented once.</p></div></details><details class="bg-white dark:bg-gray-900" id="sales-faq-htmx"><summary class="cursor-pointer dark:focus:ring-blue-400 dark:hover:bg-gray-800 dark:text-white flex focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:ring-inset font-medium hover:bg-gray-50 items-center justify-between list-none px-4 py-4 text-gray-900 text-sm text-start w-full"><span>Am I locked into HTMX?</span> <svg data-tc-chevron class="dark:text-gray-400 h-5 text-gray-500 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg></summary><div class="dark:text-gray-400 pb-4 px-4 text-gray-600 text-sm"><p class="leading-relaxed m-0 text-sm text-text-secondary">No. Components render plain, semantic HTML first; HTMX attributes are opt-in wiring, self-hosted by default so no CDN request leaves your app. If you prefer Datastar, the wire package renders one action spec into either dialect, and swapping transports is a one-line change.</p></div></details><details class="bg-white dark:bg-gray-900" id="sales-faq-styling"><summary class="cursor-pointer dark:focus:ring-blue-400 dark:hover:bg-gray-800 dark:text-white flex focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:ring-inset font-medium hover:bg-gray-50 items-center justify-between list-none px-4 py-4 text-gray-900 text-sm text-start w-full"><span>How much styling control do I have?</span> <svg data-tc-chevron class="dark:text-gray-400 h-5 text-gray-500 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg></summary><div class="dark:text-gray-400 pb-4 px-4 text-gray-600 text-sm"><p class="leading-relaxed m-0 text-sm text-text-secondary">All of it. Components emit standard Tailwind utility classes — no DaisyUI, no CSS-in-JS, no shadow DOM. Redefine a Tailwind theme token to recolor every component at once, merge your own classes into any component through BaseProps, and conflicts resolve through tailwind-merge.</p></div></details><details class="bg-white dark:bg-gray-900" id="sales-faq-cost"><summary class="cursor-pointer dark:focus:ring-blue-400 dark:hover:bg-gray-800 dark:text-white flex focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:ring-inset font-medium hover:bg-gray-50 items-center justify-between list-none px-4 py-4 text-gray-900 text-sm text-start w-full"><span>What does it cost?</span> <svg data-tc-chevron class="dark:text-gray-400 h-5 text-gray-500 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg></summary><div class="dark:text-gray-400 pb-4 px-4 text-gray-600 text-sm"><p class="leading-relaxed m-0 text-sm text-text-secondary">Nothing. MIT licensed — <a href="https://github.com/larsartmann/templ-components/blob/master/LICENSE" class="dark:text-accent-light hover:text-accent-hover text-accent underline underline-offset-2">read the license</a> — no paid tier, no telemetry. The dependency list is short and auditable — templ and tailwind-merge-go at the core, with integrations like HTMX, Datastar, ECharts, and error pages as separate opt-in modules. Adopt one component or all of them; deleting the import deletes the library.</p></div></details></div></div></div></section> <section class="py-24 relative" data-animate><div class="max-w-4xl mx-auto px-6"><div class="text-center"><h2 class="font-bold mb-4 text-[clamp(1.625rem,4vw,2.25rem)] text-text-primary tracking-tight">Try it on one screen.</h2><p class="max-w-2xl mb-8 mx-auto text-base text-text-secondary">Pick one component — a Table, a Toast, a StatCard — and drop it into an existing templ page. If it does not fit, delete the import. There is nothing to uninstall.</p><div class="flex flex-wrap gap-3 items-center justify-center"><a href="/getting-started/installation" class="bg-blue-600 cursor-pointer dark:bg-blue-500 dark:focus-visible:outline-blue-500 dark:hover:bg-blue-400 disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 font-semibold hover:-translate-y-0.5 hover:bg-blue-500 hover:shadow-accent/30 inline-flex items-center justify-center px-6 py-3 rounded-md shadow-accent/20 shadow-lg text-sm text-white transition-colors"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg>Install templ-components</a><a href="https://templcomponents-demo-132045829579.us-central1.run.app" class="bg-transparent border border-border cursor-pointer dark:hover:bg-gray-700 dark:text-gray-200 disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 font-semibold hover:-translate-y-0.5 hover:bg-transparent hover:border-border-hover hover:text-text-primary inline-flex items-center justify-center px-6 py-3.5 rounded-md text-sm text-text-secondary transition-colors" target="_blank" rel="noopener noreferrer"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>See it live</a></div></div></div></section></main><footer class="border-border border-t mt-24" data-animate><div class="border-b border-border"><div class="max-w-7xl mx-auto px-6 py-10"><div class="flex flex-col gap-6 items-start justify-between md:flex-row md:items-center"><div class="max-w-md"><h2 class="font-semibold text-lg text-text-primary">LarsArtmann Newsletter</h2><p class="mt-1 text-sm text-text-muted">Major releases and new open-source projects across all LarsArtmann work. No spam, unsubscribe anytime.</p></div><form id="newsletter-form" action="https://buttondown.email/api/emails/embed-subscribe/larsartmann" method="POST" target="popupwindow" class="flex gap-3 items-center md:w-auto w-full"><input type="email" name="email" required placeholder="you@example.com" aria-label="Email address" class="bg-bg-elevated border border-border duration-150 flex-1 focus:border-accent focus:outline-none md:w-64 min-w-0 placeholder:text-text-muted px-4 py-2.5 rounded-lg text-sm text-text-primary transition-colors"> <button type="submit" class="bg-accent border-none cursor-pointer duration-200 font-semibold hover:-translate-y-0.5 hover:bg-accent-hover hover:shadow-accent/30 px-5 py-2.5 rounded-lg shadow-accent/20 shadow-lg text-sm text-white transition-all whitespace-nowrap">Subscribe</button></form></div></div></div><div class="flex flex-col gap-4 items-center justify-between max-w-7xl md:flex-row mx-auto px-6 py-12"><div class="flex gap-2.5 items-center"><svg class="h-5 w-5" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="templ-components logo"><rect width="28" height="28" rx="6" class="fill-accent"></rect> <path d="M10 9L5 14l5 5M18 9l5 5-5 5M15.5 7l-3 14" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="text-sm text-text-muted">MIT License &#183; Built by <a href="https://larsartmann.com/" target="_blank" rel="noopener noreferrer" class="duration-150 hover:text-text-primary text-text-secondary transition-colors underline underline-offset-2">LarsArtmann</a></span></div><div class="flex gap-5 items-center text-sm"><a href="/getting-started/installation" class="duration-150 hover:text-text-primary no-underline text-text-muted transition-colors">Documentation</a> <a href="https://github.com/larsartmann/templ-components" target="_blank" rel="noopener noreferrer" class="duration-150 hover:text-text-primary no-underline text-text-muted transition-colors">GitHub</a> <a href="https://pkg.go.dev/github.com/larsartmann/templ-components" target="_blank" rel="noopener noreferrer" class="duration-150 hover:text-text-primary no-underline text-text-muted transition-colors">pkg.go.dev</a></div></div></footer></body></html>