#!/usr/bin/env bash
# Pre-commit hook for templ-components (TRACKED — activated via core.hooksPath)
#
# Originally generated by 'buildflow precommit install'; promoted to the
# tracked .githooks/ directory so fresh clones get the same guards
# (scripts/setup-hooks.sh sets `git config core.hooksPath .githooks`).
#
# NOTE: re-running 'buildflow precommit install' writes to .git/hooks/, which
# core.hooksPath overrides — reinstall by copying that file over this one and
# re-adding the guard chain below.
#
# Scope: fast guards (<100ms) + BuildFlow. The FULL verify (templ generate +
# build + test + lint across all 7 modules) is scripts/pre-commit.sh — run it
# manually before pushing; it is deliberately NOT wired into this hook.
# Performance: budget=60s, max=2m

set -e

# --- Pre-BuildFlow guards (fast, <100ms total) ---
# These run BEFORE BuildFlow to catch regressions that BuildFlow's 60s budget
# cannot cover (it doesn't run `go test ./...`).
# Guard 1: .golangci.yml disabled-linter check
#   Prevents the recurring regression where ireturn/godoclint/testableexamples
#   get silently re-added via stale working trees. Has occurred 5 times.
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
if [ -x "$REPO_ROOT/scripts/check-lint-config.sh" ]; then
    "$REPO_ROOT/scripts/check-lint-config.sh"
fi

# Guard 2: *_templ.go sync check
#   Prevents committing a generated file that has drifted from its .templ source.
#   BuildFlow's 60s budget cannot run `go test`, so TestTemplGeneratedInSync
#   only fires in CI. This <1s shell guard closes the commit-time gap.
if [ -x "$REPO_ROOT/scripts/check-templ-sync.sh" ]; then
    "$REPO_ROOT/scripts/check-templ-sync.sh"
fi

# Guard 3: Version-sync check
#   Prevents the v1.8.0 drift class where utils/version.go, CHANGELOG.md, and
#   FEATURES.md disagree. BuildFlow's 60s budget cannot run `go test`, so
#   TestVersionMatchesChangelog + TestVersionMatchesFeatures only fire in CI.
if [ -x "$REPO_ROOT/scripts/check-version-sync.sh" ]; then
    "$REPO_ROOT/scripts/check-version-sync.sh"
fi

# Guard 4: Module-sync check
#   Verifies that all go.mod module paths match their directories, replace
#   directives use relative paths, and sibling module versions are consistent.
#   Catches module structure drift at commit time (same pattern as guards 1-3).
if [ -x "$REPO_ROOT/scripts/check-module-sync.sh" ]; then
    "$REPO_ROOT/scripts/check-module-sync.sh"
fi

# Guard 5: Module DAG layer check
#   Verifies no sub-module imports from a higher layer (upward dependency).
#   Prevents cycles and broken standalone builds. See ADR-0034.
if [ -x "$REPO_ROOT/scripts/check-module-layers.sh" ]; then
    "$REPO_ROOT/scripts/check-module-layers.sh"
fi

# Guard 6: Demo CSS minification check
#   examples/demo/static/app.css must be minified (<= 5 lines). BuildFlow's
#   tailwind-build provider rewrites it un-minified (TODO #125 recurrences
#   2026-09-03 + 2026-09-08); this blocks such commits at commit time.
if [ -x "$REPO_ROOT/scripts/check-css-minified.sh" ]; then
    "$REPO_ROOT/scripts/check-css-minified.sh"
fi

echo "Running BuildFlow pre-commit checks (budget: 60s)..."

START=$(date +%s)

# Run buildflow in pre-commit mode with performance budget
buildflow --build-mode pre-commit --staged-only

# Re-stage files that may have been modified by formatters
# This ensures formatted code is included in the commit
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED_FILES" ]; then
    echo "$STAGED_FILES" | xargs -r git add
fi

END=$(date +%s)
DURATION=$((END-START))

echo "BuildFlow completed in ${DURATION}s"
