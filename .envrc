# .envrc — direnv integration for templ-components
#
# This file is loaded automatically by direnv when you cd into the repo.
# It ensures GOEXPERIMENT and GOWORK are set for ALL tools (go, gopls,
# BuildFlow, shell, IDE) — not just inside `nix develop`.
#
# Why: The flake.nix devShell shellHook only sets these inside `nix develop`.
# Tools that run outside that shell (BuildFlow daemon, IDE language servers,
# bare `go build`) miss the flags. This file closes that gap.
#
# GOEXPERIMENT=jsonv2: required until Go 1.27 stabilizes the json/v2 package.
# GOWORK=off: the root go.work references an absolute path to go-error-family
#   (Lars' machine only). GOWORK=off ensures the main module builds standalone.
export GOEXPERIMENT=jsonv2
export GOWORK=off
