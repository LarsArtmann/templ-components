package datastar

import "github.com/larsartmann/templ-components/utils"

// defaultIndicatorSpinner is the inline spinner shown when Spinner is nil.
const defaultIndicatorSpinner = "inline-block h-4 w-4 animate-spin rounded-full border-2 border-blue-600 border-t-transparent dark:border-blue-400 dark:border-t-transparent motion-reduce:animate-none"

// Indicator renders a loading indicator that shows/hides based on a Datastar
// indicator signal. Place data-indicator:<name> on the element that triggers
// a backend action, then render an Indicator wherever you want the spinner.
//
// This is the Datastar equivalent of htmx.LoadingIndicator.
//
//	<button data-on:click="@post('/save')" data-indicator:saving>Save</button>
//	@datastar.Indicator(datastar.IndicatorProps{Signal: "saving"})
//
// With a custom spinner:
//
//	@datastar.Indicator(datastar.IndicatorProps{
//	    Signal:  "saving",
//	    Spinner: feedback.Spinner(feedback.SpinnerProps{Size: feedback.SpinnerSM}),
//	})
templ Indicator(props IndicatorProps) {
	<div
		data-show={ indicatorSignalExpr(props.Signal) }
		class={ utils.Class("flex items-center justify-center", props.Class) }
		role="status"
		aria-live="polite"
		if props.ID != "" {
			id={ props.ID }
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
		{ props.Attrs... }
	>
		if props.Spinner != nil {
			@props.Spinner
		} else {
			<span class={ defaultIndicatorSpinner }></span>
		}
	</div>
}
