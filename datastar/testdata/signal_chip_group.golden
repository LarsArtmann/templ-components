<div class="flex flex-wrap gap-2 items-center" role="group" aria-label="Filter by state"><button type="button" data-on:click="$stateFilter=&#39;&#39;" data-class="{ &#39;border-accent-600 bg-accent-600 text-white hover:bg-accent-700 dark:border-accent-500 dark:bg-accent-600 dark:text-white dark:hover:bg-accent-700&#39;: $stateFilter===&#39;&#39;, &#39;border-gray-300 bg-white text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700&#39;: $stateFilter!==&#39;&#39; }" data-attr:aria-pressed="$stateFilter===&#39;&#39; ? &#39;true&#39; : &#39;false&#39;" class="bg-white border border-gray-300 cursor-pointer dark:bg-gray-800 dark:border-gray-600 dark:hover:bg-gray-700 dark:text-gray-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 font-medium hover:bg-gray-100 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-3 py-1 rounded-full text-gray-700 text-sm transition-colors" aria-pressed="false">All</button><button type="button" data-on:click="$stateFilter=&#39;open&#39;" data-class="{ &#39;border-accent-600 bg-accent-600 text-white hover:bg-accent-700 dark:border-accent-500 dark:bg-accent-600 dark:text-white dark:hover:bg-accent-700&#39;: $stateFilter===&#39;open&#39;, &#39;border-gray-300 bg-white text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700&#39;: $stateFilter!==&#39;open&#39; }" data-attr:aria-pressed="$stateFilter===&#39;open&#39; ? &#39;true&#39; : &#39;false&#39;" data-signals="{&#39;stateFilter&#39;:&#39;open&#39;}" class="bg-accent-600 border border-accent-600 cursor-pointer dark:bg-accent-600 dark:border-accent-500 dark:hover:bg-accent-700 dark:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 font-medium hover:bg-accent-700 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-3 py-1 rounded-full text-sm text-white transition-colors" aria-pressed="true">Open <span class="font-normal ms-1.5 tabular-nums">5</span></button><button type="button" data-on:click="$stateFilter=&#39;done&#39;" data-class="{ &#39;border-accent-600 bg-accent-600 text-white hover:bg-accent-700 dark:border-accent-500 dark:bg-accent-600 dark:text-white dark:hover:bg-accent-700&#39;: $stateFilter===&#39;done&#39;, &#39;border-gray-300 bg-white text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700&#39;: $stateFilter!==&#39;done&#39; }" data-attr:aria-pressed="$stateFilter===&#39;done&#39; ? &#39;true&#39; : &#39;false&#39;" class="bg-white border border-gray-300 cursor-pointer dark:bg-gray-800 dark:border-gray-600 dark:hover:bg-gray-700 dark:text-gray-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 font-medium hover:bg-gray-100 inline-flex items-center motion-reduce:duration-0 motion-reduce:transition-none px-3 py-1 rounded-full text-gray-700 text-sm transition-colors" aria-pressed="false">Done</button></div>