<div id="tc-datastar-announcer" aria-live="polite" class="sr-only"></div><script nonce="test-nonce">
		(function() {
			'use strict';
			var DURATION = 6000;
			function announce(text) {
				var announcer = document.getElementById('tc-datastar-announcer');
				if (announcer) announcer.textContent = text;
			}
			document.addEventListener('datastar-fetch', function(evt) {
				var detail = evt.detail || {};
				var args = detail.argsRaw || {};
				if (detail.type === 'error') {
					var status = args.status ? ' (HTTP ' + args.status + ')' : '';
					console.error('DataStar stream error:', detail);
					announce('Stream error' + status);
					if (typeof tcShowToast === 'function') {
						tcShowToast('The live stream endpoint returned an error' + status + '.', 'error', 'Stream Error', DURATION);
					}
				} else if (detail.type === 'retries-failed') {
					console.error('DataStar stream failed: retries exhausted', detail);
					announce('Live stream lost. Automatic reconnection failed.');
					if (typeof tcShowToast === 'function') {
						tcShowToast('The live stream was lost and automatic reconnection failed. Reload the page to resume.', 'error', 'Connection Lost', DURATION);
					}
				} else if (detail.type === 'retrying') {
					console.warn('DataStar stream interrupted, retrying...', detail);
				}
			});
		})();
	</script>